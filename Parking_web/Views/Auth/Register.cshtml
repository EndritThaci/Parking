@model Parking_web.Models.DTO.UserCreateDTO

@{
    ViewData["Title"] = "Regjistrimi";
}

<div class="login-wrapper">
    <div class="login-card">
        <div class="brand-section">
            <div class="brand-glow"></div>
            <div class="brand-content">
                <div class="logo-box mb-4">
                    <img src="~/Logo/Logo.png" alt="Endriti Parking Logo" class="brand-logo" asp-append-version="true" />
                </div>
                <h2 class="fw-bold text-white mb-2">Endriti Parking</h2>
                <p class="brand-subtitle">Bashkohuni me platformën tonë për menaxhimin më të lehtë të parkimit.</p>
                
                <div class="brand-features mt-4 d-none d-md-flex flex-column gap-3 text-start">
                    <div class="feature-item d-flex align-items-center gap-3">
                        <div class="feature-icon"><i class="bi bi-person-check"></i></div>
                        <span>Regjistrim i shpejtë dhe i lehtë</span>
                    </div>
                    <div class="feature-item d-flex align-items-center gap-3">
                        <div class="feature-icon"><i class="bi bi-shield-lock"></i></div>
                        <span>Mbrojtje e plotë e të dhënave</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-header text-center text-md-start mb-4">
                <h3 class="fw-bold text-dark mb-1">Krijo Llogari</h3>
                <p class="text-muted">Plotësoni të dhënat tuaja për t'u regjistruar.</p>
            </div>

            <form asp-action="Register" method="post" id="registerForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-3 small"></div>

                <div class="mb-3">
                    <label asp-for="Emri" class="form-label text-secondary fw-semibold small">Emri</label>
                    <div class="input-group" onclick="document.getElementById('emriInput').focus();">
                        <span class="input-group-text custom-addon">
                            <i class="bi bi-person text-primary"></i>
                        </span>
                        <input asp-for="Emri" id="emriInput" class="form-control custom-input last-input" placeholder="Emri" autocomplete="given-name" />
                    </div>
                    <span asp-validation-for="Emri" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Mbiemri" class="form-label text-secondary fw-semibold small">Mbiemri</label>
                    <div class="input-group" onclick="document.getElementById('mbiemriInput').focus();">
                        <span class="input-group-text custom-addon">
                            <i class="bi bi-person-badge text-primary"></i>
                        </span>
                        <input asp-for="Mbiemri" id="mbiemriInput" class="form-control custom-input last-input" placeholder="Mbiemri" autocomplete="family-name" />
                    </div>
                    <span asp-validation-for="Mbiemri" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-secondary fw-semibold small">Adresa e Email-it</label>
                    <div class="input-group" onclick="document.getElementById('emailInput').focus();">
                        <span class="input-group-text custom-addon">
                            <i class="bi bi-envelope text-primary"></i>
                        </span>
                        <input asp-for="Email" id="emailInput" class="form-control custom-input last-input" placeholder="emri@shembull.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Passwordi" class="form-label text-secondary fw-semibold small">Fjalëkalimi</label>
                    <div class="input-group">
                        <span class="input-group-text custom-addon" onclick="document.getElementById('passwordInput').focus();">
                            <i class="bi bi-lock text-primary"></i>
                        </span>
                        <input asp-for="Passwordi" id="passwordInput" type="password" class="form-control custom-input" style="border-right: none;" placeholder="••••••••" autocomplete="new-password" />
                        <button class="custom-addon-btn" type="button" id="togglePassword">
                            <i class="bi bi-eye text-muted pe-2" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Passwordi" class="text-danger small mt-1 d-block"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-submit w-100 py-2-5 fw-bold mb-4">
                    <span>Regjistrohu</span>
                    <i class="bi bi-check-circle ms-2"></i>
                </button>

                <div class="text-center pt-2 border-top">
                    <p class="text-muted small mb-0">
                        Keni një llogari ekzistuese?
                        <a asp-action="Login" class="text-primary fw-bold text-decoration-none ms-1 hover-underline">Kyçu Këtu</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .login-card {
        width: 100%;
        max-width: 960px;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08), 0 10px 15px rgba(0, 0, 0, 0.04);
        display: flex;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .brand-section {
        flex: 1;
        background: linear-gradient(135deg, #0a192f 0%, #0d3b66 50%, #001f3f 100%);
        padding: 3.5rem 3rem;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: #ffffff;
        overflow: hidden;
    }

    .brand-glow {
        position: absolute;
        width: 250px;
        height: 250px;
        background: radial-gradient(circle, rgba(13, 110, 253, 0.35) 0%, rgba(0, 0, 0, 0) 70%);
        top: 20%;
        left: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
    }

    .brand-content {
        position: relative;
        z-index: 2;
    }

    .brand-logo {
        width: 120px;
        height: 120px;
        object-fit: contain;
        border-radius: 30px;
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.35);
        border: 2px solid rgba(255, 255, 255, 0.15);
        transition: transform 0.3s ease;
    }

    .brand-logo:hover {
        transform: scale(1.05);
    }

    .brand-subtitle {
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .feature-item {
        background: rgba(255, 255, 255, 0.06);
        padding: 0.75rem 1rem;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(5px);
        font-size: 0.9rem;
    }

    .feature-icon {
        width: 32px;
        height: 32px;
        background: rgba(13, 110, 253, 0.3);
        color: #6ea8fe;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .form-section {
        flex: 1.1;
        padding: 3.5rem 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #ffffff;
    }

    .custom-input {
        border-left: none !important;
        border-color: #e2e8f0;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
    }

    .last-input {
        border-top-right-radius: 12px !important;
        border-bottom-right-radius: 12px !important;
    }

    .custom-addon {
        background-color: #f8fafc;
        border-color: #e2e8f0;
        border-right: none !important;
        padding-left: 1rem;
        padding-right: 0.5rem;
        border-top-left-radius: 12px !important;
        border-bottom-left-radius: 12px !important;
    }

    .custom-addon-btn {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-left: none;
        border-top-right-radius: 12px !important;
        border-bottom-right-radius: 12px !important;
    }

    .input-group:focus-within .custom-addon,
    .input-group:focus-within .custom-input,
    .input-group:focus-within .custom-addon-btn {
        border-color: #0d6efd;
        background-color: #ffffff;
    }

    .custom-input:focus {
        box-shadow: none !important;
    }

    .btn-submit {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        border: none;
        padding: 0.85rem;
        border-radius: 12px;
        font-size: 1rem;
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.25);
        transition: all 0.25s ease;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.35);
        background: linear-gradient(135deg, #0b5ed7 0%, #0a58ca 100%);
    }

    .hover-underline:hover {
        text-decoration: underline !important;
    }

    @@media (max-width: 768px) {
        .login-card {
            flex-direction: column;
            border-radius: 18px;
        }

        .brand-section {
            padding: 2.5rem 1.5rem;
        }

        .form-section {
            padding: 2.5rem 1.5rem;
        }

        .brand-logo {
            width: 90px;
            height: 90px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const togglePassword = document.getElementById("togglePassword");
            const passwordInput = document.getElementById("passwordInput");
            const toggleIcon = document.getElementById("toggleIcon");

            if (togglePassword && passwordInput && toggleIcon) {
                togglePassword.addEventListener("click", function () {
                    const isPassword = passwordInput.getAttribute("type") === "password";
                    passwordInput.setAttribute("type", isPassword ? "text" : "password");
                    toggleIcon.classList.toggle("bi-eye");
                    toggleIcon.classList.toggle("bi-eye-slash");
                });
            }
        });
    </script>
}