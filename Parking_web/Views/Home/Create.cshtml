@model Parking_web.Models.DTO.TransaksionetCreateDto
@{
    ViewData["Title"] = "Konfirmimi i Rezervimit";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-5">
                <div class="card-header bg-primary text-white py-3 text-center rounded-top-5">
                    <h4 class="mb-0 fw-bold">Konfirmimi i Transaksionit</h4>
                    <small class="opacity-75">Ju lutem rishikoni të dhënat para vazhdimit</small>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-exclamation-circle text-warning" style="font-size: 3rem;"></i>
                        <h5 class="fw-bold mt-2">A jeni i sigurt?</h5>
                        <p class="text-muted">Po filloni një transaksion të ri me këto të dhëna:</p>
                    </div>

                    <form asp-action="EntryQR" method="get">
                        <input type="hidden" name="njesiaId" value="@Model.NjesiaId" />

                        <ul class="list-group list-group-flush border rounded mb-4">
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <span class="text-muted small text-uppercase fw-bold">Njësisa:</span>
                                <span class="fw-bold text-dark">@ViewBag.NjesiaEmri</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <span class="text-muted small text-uppercase fw-bold">Koha e Fillimit:</span>
                                <span class="fw-bold text-dark">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                            </li>
                            <li class="list-group-item py-3">
                                <label for="identifikues" class="text-muted small text-uppercase fw-bold mb-2">
                                    Targa e automjetit
                                    <span class="text-secondary fw-normal">(opsionale)</span>
                                </label>

                                <input type="text"
                                       id="identifikues"
                                       name="identifikues"
                                       class="form-control form-control-lg rounded-3 text-uppercase"
                                       placeholder="p.sh. 01 123 AB"
                                       maxlength="50"
                                       autocomplete="off" />
                            </li>
                        </ul>
                        <div class="d-grid gap-2">
                            @if(ViewBag.QRScanner){
                                <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm"> Konfirmo dhe Vazhdo </button>
                            }
                            else{
                                <button type="button" id="cameraButton" onclick="openCamera()" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm"><i class="bi bi-qr-code-scan me-1"></i> Skano </button>
                            }
                            <a asp-action="Index" class="btn rounded-pill fw-bold border-0"> Anulo </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="cameraModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-qr-code-scan me-2"></i>
                        Skano QR Kodin
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="stopCamera()"> </button>
                </div>
                <div class="modal-body">
                    <div id="qr-reader" style="width: 100%;"></div>
                    <div id="qr-loading" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">
                                Loading...
                            </span>
                        </div>
                        <div class="fw-semibold">
                            Duke verifikuar QR kodin...
                        </div>
                        <small class="text-muted">
                            Ju lutem prisni
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const identifikues = document.getElementById("identifikues");
            if (!identifikues) {
                return;
            }

            identifikues.addEventListener("keydown", function (event) {
                if (event.key !== "Enter") {
                    return;
                }
                event.preventDefault();
                const cameraButton = document.getElementById("cameraButton");
                if (cameraButton) {
                    openCamera();
                }
            });
        });

        let qrScanner = null;
        let qrProcessing = false;

        async function openCamera() {
            const modalElement = document.getElementById("cameraModal");
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            modal.show();

            qrProcessing = false;

            document.getElementById("qr-reader").classList.remove("d-none");
            document.getElementById("qr-loading").classList.add("d-none");
            
            setTimeout(async () => {
                try {
                    await stopCamera();
                    qrScanner = new Html5Qrcode("qr-reader");

                    await qrScanner.start(
                        { facingMode: "environment" },
                        {
                            fps: 10,
                            qrbox: {
                                width: 250,
                                height: 250
                            }
                        },
                        async (decodedText) => {
                            if (qrProcessing) {
                                return;
                            }
                             qrProcessing = true;

                            document.getElementById("qr-reader").classList.add("d-none");
                            document.getElementById("qr-loading").classList.remove("d-none");

                            await stopCamera();
                            await handleQrCode(decodedText);
                        },
                        (errorMessage) => { }
                    );
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Gabim!',
                        text: 'Nuk mund të hapet kamera. Kontrolloni lejen për përdorimin e kamerës.',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'Kuptova'
                    });
                    modal.hide();
                }
            }, 300);
        }
        async function stopCamera() {
            if (qrScanner) {
                try {
                    await qrScanner.stop();
                    await qrScanner.clear();
                } catch (error) {
                    console.error("Error stopping camera:", error);
                }

                qrScanner = null;
            }
        }
        async function handleQrCode(value) {
            try {
                const identifikues = document.getElementById("identifikues").value.trim();
                const response = await fetch(
                    `/Home/QRReader?encrypted=${encodeURIComponent(value)}&njesiaId=${@Model.NjesiaId}&identifikues=${encodeURIComponent(identifikues)}`,
                    {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );
                console.log(response);
                const result = await response.json();
                console.log(result);

                if (result.success) {
                    const modalElement = document.getElementById("cameraModal");
                    const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                    modal.hide();

                    Swal.fire({
                        icon: "success",
                        title: "QR i vlefshëm",
                        text: "QR kodi u verifikua me sukses.",
                        timer: 1500,
                        showConfirmButton: false,
                        timerProgressBar: true
                    });

                     window.location.href = `/Home/Index`;

                } else {
                    const modalElement = document.getElementById("cameraModal");
                    const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                    modal.hide();

                    await Swal.fire({
                        icon: "error",
                        title: "QR i pavlefshëm",
                        text: result.message ?? "Ky QR Kod është i pavlefshëm..",
                        confirmButtonText: "Kuptova"
                    });

                    qrProcessing = false;
                }
            } catch (error) {
                console.error("QR validation error:", error);

                const modalElement = document.getElementById("cameraModal");
                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.hide();

                await Swal.fire({
                    icon: "error",
                    title: "Gabim!",
                    text: "Ndodhi një gabim gjatë verifikimit të QR kodit.",
                    confirmButtonText: "Kuptova"
                });

                qrProcessing = false;
            }
        }
    </script>
}