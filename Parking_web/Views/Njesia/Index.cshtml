@using Parking_web.Models.DTO
@model NjesiReadDto
@{
    ViewData["Title"] = "Menaxhimi i Njësisë";
}


<style>
    .btn-edit-custom {
        color: #ffc107;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }

        .btn-edit-custom:hover {
            border-color: #ffc107 !important;
            background-color: rgba(255, 193, 7, 0.1);
            color: #ba8b00;
        }

    .btn-delete-custom {
        color: #dc3545;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }

        .btn-delete-custom:hover {
            border-color: #dc3545 !important;
            background-color: rgba(220, 53, 69, 0.1);
            color: #a71d2a;
        }

    .btn-activate-custom {
        color: #0d6efd;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }

        .btn-activate-custom:hover {
            border-color: #0d6efd !important;
            background-color: rgba(13, 110, 253, 0.1);
            color: #0a58ca;
        }

    .card-header {
        padding: 0 !important;
        overflow: hidden;
        position: relative;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 1rem 1.5rem;
    }

    .clickable-title {
        cursor: pointer;
        flex-grow: 1;
        display: flex;
        align-items: center;
        z-index: 1;
    }

    .action-button-area {
        position: relative;
        z-index: 1050;
    }

    .btn-minimize i {
        display: inline-block;
        transition: transform 0.3s ease-in-out;
    }

    .collapsed .btn-minimize i {
        transform: rotate(-90deg);
    }
</style>

<div class="container my-5 pb-5">
    <div class="header-content">
        <div>
            <h2 class="fw-bold text-dark mb-1">Menaxhimi i Njesisë @Model.Emri</h2>
            <p class="text-muted small">Kontrolloni lokacionet dhe cilësimet tuaja në një vend.</p>
        </div>
        @if (!Model.QRScanner && ViewBag.customers)
        {
            <div>
                <a asp-action="NjesiaQR" asp-route-id="@Model.NjesiteId" class="btn btn-outline-primary btn-sm px-4 rounded-pill fw-semibold"><i class="bi bi-qr-code-scan"></i> QR Kodi</a>
            </div>
        }
    </div>

    @{
        var sherbimet = ViewBag.Sherbimet as List<Parking_web.Models.Sherbimi>;
    }
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-header bg-black text-white">
            <div class="header-content">
                <div class="clickable-title" data-bs-toggle="collapse" data-bs-target="#collSherbimet">
                    <span class="btn-minimize me-3"><i class="bi bi-chevron-down"></i></span>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">Menaxhimi i Shërbimeve</h4>
                        <small class="opacity-75">Lista e shërbimeve dhe çmimeve</small>
                    </div>
                </div>
                <div class="action-button-area">
                    <a asp-controller="Sherbimi" asp-action="Create" class="btn btn-outline-light btn-sm px-4 rounded-pill fw-semibold">Shto Shërbim</a>
                </div>
            </div>
        </div>
        <div id="collSherbimet" class="collapse show">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 w-100">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Emri</th>
                                <th>Çmimi</th>
                                <th class="text-end pe-4">Veprimet</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (sherbimet != null)
                            {
                                foreach (var s in sherbimet)
                                {
                                    <tr>
                                        <td class="fw-bold ps-4">@s.Emri</td>
                                        <td>
                                            @if (s.Cmimi != 0)
                                            {
                                                <span class="text-success fw-bold">@s.Cmimi.ToString("N2") €</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a asp-controller="Sherbimi" asp-action="Edit" asp-route-id="@s.SherbimiId" class="btn btn-sm btn-edit-custom fw-semibold">
                                                    <i class="bi bi-pencil me-1"></i>
                                                </a>
                                                <a asp-controller="Sherbimi" asp-action="Delete" asp-route-id="@s.SherbimiId" class="btn btn-sm btn-delete-custom fw-semibold">
                                                    <i class="bi bi-trash me-1"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @{
        var cilsimet = (ViewBag.Cilsimet as List<Parking_web.Models.DTO.CilsimetReadDto>)?.OrderBy(n => n.NjesiOrg.Emri).ThenBy(c => c.Emri);
    }
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-header bg-black text-white">
            <div class="header-content">
                <div class="clickable-title" data-bs-toggle="collapse" data-bs-target="#collCilsimet">
                    <span class="btn-minimize me-3"><i class="bi bi-chevron-down"></i></span>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">Cilësimet e Parkimit</h4>
                        <small class="opacity-75">Lidhja mes njësive dhe shërbimeve</small>
                    </div>
                </div>
                <div class="action-button-area">
                    <a asp-controller="Cilsimet" asp-route-id="@Model.NjesiteId" asp-action="Create" class="btn btn-outline-light btn-sm px-4 rounded-pill fw-semibold">Shto Cilësim</a>
                </div>
            </div>
        </div>
        <div id="collCilsimet" class="collapse show">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 w-100">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Emri</th>
                                <th>Njësia</th>
                                <th class="d-none d-md-table-cell">Sherbimi</th>
                                <th class="text-end pe-4">Veprimet</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (cilsimet != null)
                            {
                                foreach (var c in cilsimet)
                                {
                                    <tr>
                                        <td class="fw-bold ps-4">@c.Emri</td>
                                        <td class="small">@c.NjesiOrg?.Emri</td>
                                        <td class="d-none d-md-table-cell text-muted">@c.Sherbimi.Emri</td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end align-items-center gap-2">
                                                @if (!c.Selected)
                                                {
                                                    <form asp-controller="Cilsimet" asp-action="Activate" asp-route-id="@c.CilsimetiId" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-activate-custom fw-semibold"> Aktivizo</button>
                                                    </form>
                                                }
                                                <div class="d-flex gap-1">
                                                    <a asp-controller="Cilsimet" asp-action="Edit" asp-route-id="@c.CilsimetiId" asp-route-njesiaId="@Model.NjesiteId" class="btn btn-sm btn-edit-custom fw-semibold">
                                                        <i class="bi bi-pencil me-1"></i>
                                                    </a>
                                                    <a asp-controller="Cilsimet" asp-action="Delete" asp-route-id="@c.CilsimetiId" class="btn btn-sm btn-delete-custom fw-semibold">
                                                        <i class="bi bi-trash me-1"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @{
        var detajet = (ViewBag.Detajet as List<Parking_web.Models.DTO.DetajetReadDto>)?
            .OrderBy(n => n.CilsimetParkimit.NjesiOrg.Emri)
            .ThenBy(c => c.CilsimetParkimit.Emri)
            .ThenBy(d => d.FromHour);
    }
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-header bg-black text-white">
            <div class="header-content">
                <div class="clickable-title" data-bs-toggle="collapse" data-bs-target="#collDetajet">
                    <span class="btn-minimize me-3"><i class="bi bi-chevron-down"></i></span>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">Detajet e Tarifave</h4>
                        <small class="opacity-75">Çmimet sipas orëve</small>
                    </div>
                </div>
                <div class="action-button-area">
                    <a asp-controller="Detajet" asp-action="Create" class="btn btn-outline-light btn-sm px-4 rounded-pill fw-semibold">Shto Detaj</a>
                </div>
            </div>
        </div>
        <div id="collDetajet" class="collapse show">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 w-100">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Orari</th>
                                <th>Çmimi/h</th>
                                <th class="d-none d-lg-table-cell">Cilësimi</th>
                                <th class="d-none d-md-table-cell text-center">Statusi</th>
                                <th class="text-end pe-4">Veprimet</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (detajet != null)
                            {
                                foreach (var d in detajet)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold">@d.FromHour:00 - @(d.ToHour.HasValue ? d.ToHour + ":00 h" : "∞")</div>
                                        </td>
                                        <td class="text-success fw-bold">@d.Cmimi.ToString("N2") €</td>
                                        <td class="d-none d-lg-table-cell small text-muted">@d.CilsimetParkimit.Emri</td>
                                        <td class="d-none d-md-table-cell text-center">
                                            @if (d.CilsimetParkimit.Selected)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Aktiv</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a asp-controller="Detajet" asp-action="Edit" asp-route-id="@d.DetajetId" class="btn btn-sm btn-edit-custom fw-semibold">
                                                    <i class="bi bi-pencil me-1"></i>
                                                </a>
                                                <a asp-controller="Detajet" asp-action="Delete" asp-route-id="@d.DetajetId" class="btn btn-sm btn-delete-custom fw-semibold">
                                                    <i class="bi bi-trash me-1"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.querySelectorAll('.action-button-area').forEach(area => {
            area.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });
    </script>
}