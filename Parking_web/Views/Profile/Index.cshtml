@model Parking_web.Models.DTO.UserReadDTO

@{
    ViewData["Title"] = "Profili";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 mb-4">
                <div class="mb-3">
                    <img src="https://ui-avatars.com/api/?name=@Model.Emri+@Model.Mbiemri&background=0d6efd&color=fff&size=128"
                         class="rounded-circle shadow-sm border border-3 border-white" alt="Profile Picture">
                </div>
                <h4 class="fw-bold mb-0">@Model.Emri @Model.Mbiemri</h4>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mt-2">
                    <i class="bi bi-shield-check me-1"></i> @Model.Role
                </span>

                <hr class="my-4 opacity-50">

                <div class="text-start">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-shape bg-light rounded-3 me-3">
                            <i class="bi bi-building text-muted"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Biznesi / Organizata</small>
                            @if (ViewBag.UserOrg != null && ViewBag.UserOrg.Count > 0)
                            {
                                foreach (var userOrg in ViewBag.UserOrg)
                                {
                                    <span class="fw-semibold d-block">
                                        @(userOrg.Organizata?.EmriBiznesit ?? "Pa Organizatë")
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="fw-semibold">
                                    Pa Organizatë
                                </span>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        
                        @if (User.IsInRole("Manager") || User.IsInRole("Employee"))
                        {
                            <div class="icon-shape bg-light rounded-3 me-3">
                                <i class="bi bi-geo-alt text-muted"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Njësia Organizative</small>
                                 @if (ViewBag.UserOrg != null &&
                                        ViewBag.UserOrg.Count > 0)
                                {
                                    foreach (var userOrg in ViewBag.UserOrg)
                                    {
                                        <span class="fw-semibold d-block">
                                            @(userOrg.Njesi?.Emri ?? "Pa Njësi")
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="fw-semibold">
                                        Pa Njësi
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            @if(User.IsInRole("Manager") || User.IsInRole("Admin") || User.IsInRole("Super Admin"))
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3">Veprime të Shpejta</h5>
                    <div class="d-flex gap-2">
                        <a asp-controller="Transaksion" asp-action=@(User.IsInRole("Manager")?"IndexManager":"Index") class="btn btn-light border flex-grow-1 col-lg-6 rounded-3">
                            <i class="bi bi-list-ul d-block mb-1 fs-4"></i> Transaksionet
                        </a>
                        <a asp-controller="LibriShitjes" asp-action="GetLibriCustom" class="btn btn-light border flex-grow-1 col-lg-6 rounded-3">
                            <i class="bi bi-file-earmark-excel d-block mb-1 fs-4"></i> Raportet   
                        </a>
                    </div>
                </div>
            }
            else if (User.IsInRole("Customer"))
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3">Konfigurimet</h5>
                    <div class="d-flex gap-2">
                        <a asp-controller="Profile" asp-action="UserOrgs" class="btn btn-light border flex-grow-1 col-lg-12 rounded-3">
                            <i class="bi bi-gear d-block mb-1 fs-4"></i> Zgjedh Organizatat
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-4">Të dhënat Personale</h5>

                <form asp-controller="Profile" asp-action="ChangeName" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Emri</label>
                            <input type="text" name="Emri" class="form-control bg-light border-0" value="@Model.Emri">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Mbiemri</label>
                            <input type="text" name="Mbiemri" class="form-control bg-light border-0" value="@Model.Mbiemri">
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-muted">Adresa Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-envelope"></i></span>
                                <input type="text" class="form-control bg-light border-0" value="@Model.Email" readonly>
                            </div>
                        </div>
                        <div id="passwordBtnSection" class="col-6 mt-4">
                            <button type="button" onclick="togglePasswordForm()" class="btn btn-outline-primary btn-sm rounded-pill px-4 py-2 shadow-sm">
                                <i class="bi bi-key me-1"></i> Ndrysho Passwordin
                            </button>
                        </div>
                        <div id="nameChangeBtn" class="col-6 mt-4 text-end">
                            <button type="submit" class="btn btn-primary rounded-pill btn-sm px-5 py-2 shadow-sm fw-bold">
                                Ruaj Ndryshimet
                            </button>
                        </div>
                    </div>
                </form>

                <div id="passwordFormSection" style="display: none;">
                    <div class="mt-4 pt-3 border-top">
                        <form asp-controller="Profile" asp-action="ChangePassword" method="post" class="bg-light p-3 rounded-4 shadow-sm">
                            @Html.AntiForgeryToken()
                            <div class="row g-2">
                                <div class="col-12">
                                    <input type="password" name="OldPassword" class="form-control form-control-sm py-2 border-0 shadow-sm" placeholder="Passwordi aktual" required>
                                </div>
                                <div class="col-md-12">
                                    <input type="password" name="NewPassword" class="form-control form-control-sm py-2 border-0 shadow-sm" placeholder="Passwordi i ri" required>
                                </div>
                                <div class="col-md-12">
                                    <input type="password" name="ConfirmPassword" class="form-control form-control-sm py-2 border-0 shadow-sm" placeholder="Konfirmo passwordin" required>
                                </div>
                                <div class="col-12 d-flex gap-2 mt-2">
                                    <button type="submit" class="btn btn-primary btn-sm py-2 rounded-pill flex-grow-1">
                                        Ruaj Ndryshimet
                                    </button>
                                    <button type="button" onclick="togglePasswordForm()" class="btn btn-light btn-sm py-2 rounded-pill border shadow-sm px-3">
                                        Kthehu
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            
            @if (User.IsInRole("Customer"))
            {

                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-credit-card-2-front me-2 text-primary"></i>Llogaritë dhe Kartelat
                    </h5>

                    @{
                        var cards = ViewBag.CardDetails as IEnumerable<Parking_web.Models.DTO.CreditCardReadDto>;
                    }

                    @if (cards != null && cards.Any())
                    {
                        <div class="row g-3 mb-4">
                            @foreach (var card in cards)
                            {
                                <div class="col-md-6">
                                    <div class="p-3 ps-2 rounded-4 border bg-gradient position-relative overflow-hidden"
                                    style="min-height: 160px;">

                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-credit-card text-primary fs-3"></i>
                                                <span class="fw-bold small text-uppercase opacity-75">
                                                    @card.Brand
                                                </span>
                                            </div>

                                            <form id="deleteForm-@card.Id"
                                            method="post"
                                            asp-action="deleteCard"
                                            asp-controller="BankAccount"
                                            class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@card.Id" />

                                                <button type="button"
                                                onclick="confirmDelete(@card.Id, 'Largo Katelën?', 'A jeni i sigurt që dëshironi ta largoni këtë kartelë?')"
                                                class="btn btn-sm btn-light border rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                                                style="width: 32px; height: 32px;">
                                                    <i class="bi bi-x-lg text-danger"></i>
                                                </button>
                                            </form>
                                        </div>


                                        <h5 class="mb-3 tracking-widest text-center">
                                            **** **** **** @card.Last4
                                        </h5>


                                        <div class="d-flex justify-content-between align-items-end mt-auto">
                                            <div>
                                                <small class="d-block opacity-50" style="font-size: 0.7rem;">PRONARI</small>
                                                <span class="small fw-semibold">@Model.Emri @Model.Mbiemri</span>
                                            </div>
                                            <div class="text-end">
                                                <small class="d-block opacity-50" style="font-size: 0.7rem;">SKADIMI</small>
                                                <span class="small fw-semibold">@($"{card.ExpMonth:D2}/{card.ExpYear % 100:D2}")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border-0 small rounded-3 mb-4 text-center py-3">
                            <i class="bi bi-wallet2 fs-2 d-block mb-2 text-muted"></i>
                            Nuk keni asnjë kartelë të regjistruar.
                        </div>
                    }
                </div>
        
                <div>
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                        <h5 class="fw-bold mb-4">
                            <i class="bi bi-credit-card-2-front me-2 text-primary"></i>Regjistro Kartelën Bankare
                        </h5>

                        <form id="stripe-form" asp-controller="BankAccount" asp-action="createCard" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label fw-bold">Kartela</label>
                                <div id="card-element" class="form-control"></div>
                                <div id="card-errors" class="text-danger small mt-1"></div>
                            </div>

                            <input type="hidden" name="paymentMethodId" id="paymentMethodId" />

                            <button type="submit" class="btn btn-primary">
                                Ruaj Kartelën
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f4f7f6;
    }

    .icon-shape {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-control[readonly] {
        cursor: default;
        font-weight: 500;
    }
    .tracking-widest {
        letter-spacing: 0.2rem;
    }
    .bg-gradient:hover {
        transform: translateY(-3px);
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.15);
    }
</style>

<script>
    function togglePasswordForm() {
        const btnSection = document.getElementById('passwordBtnSection');
        const formSection = document.getElementById('passwordFormSection');
        const nameChangeBtn = document.getElementById('nameChangeBtn');

        if (formSection.style.display === 'none') {
            formSection.style.display = 'block';
            btnSection.style.display = 'none';
            nameChangeBtn.classList.remove('col-6');
            nameChangeBtn.classList.add('col-12');
        } else {
            formSection.style.display = 'none';
            btnSection.style.display = 'block';
            nameChangeBtn.classList.remove('col-12');
            nameChangeBtn.classList.add('col-6');
        }
    }
</script>

<script src="https://js.stripe.com/v3/"></script>

<script>
    const stripe = Stripe("pk_test_51T6URw2KyY4CWYf6n7QDoHhRq749SJuvwzfzSNLLLcMqyF0MiDccEVCq9jXFx46Jb3I11KqEvBIWNCpnkhWfKmPN002onMdS88");
    const elements = stripe.elements();

    const card = elements.create("card");
    card.mount("#card-element");

    const form = document.getElementById("stripe-form");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const { paymentMethod, error } = await stripe.createPaymentMethod({
            type: "card",
            card: card
        });

        if (error) {
            document.getElementById("card-errors").textContent = error.message;
            return;
        }

        document.getElementById("paymentMethodId").value = paymentMethod.id;
        form.submit();
    });
</script>