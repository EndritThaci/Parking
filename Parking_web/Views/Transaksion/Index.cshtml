@model Parking_web.Models.DTO.TransaksionPage
@{
    ViewData["Title"] = "Transaksionet";
}

@{
    int.TryParse(Context.Request.Query["njesia"], out int selectedNjesia);
}

<div class="container-fluid px-2 px-md-4 py-3">

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-black text-white pt-4 px-3 px-md-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-3 gap-3">
                <div>
                    <h4 class="fw-bold mb-0">Historia e Transaksioneve</h4>
                    <small class="opacity-75">Regjistri i hyrjeve dhe daljeve</small>
                </div>
                <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
                    <div class="action-button-area">
                        <a asp-controller="LibriShitjes" asp-action="GetLibriCustom" class="btn btn-outline-light px-4 rounded-pill fw-bold w-100">Gjenero Librin</a>
                    </div>
                    <div style="min-width: 220px;">
                        <select id="filterNjesia" class="form-select bg-black fw-bold text-white rounded-pill border-white">
                            <option value="-1">Të gjitha Njësitë</option>

                            @foreach (var njesi in Model.Njesite)
                            {
                                <option value="@njesi.NjesiteId" selected="@(njesi.NjesiteId == selectedNjesia)">
                                    @njesi.Emri
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 w-100" id="transaksionetTable">
                    <thead>
                        <tr>
                            <th class="ps-3 ps-md-4">Vend Parkimi</th>
                            @if (!User.IsInRole("Customer"))
                            {
                                <th class="d-none d-md-table-cell">Perdoruesi</th>
                            }
                            <th>Hyrja</th>
                            <th class="d-none d-lg-table-cell">Dalja</th>
                            <th class="d-none d-sm-table-cell">Statusi</th>
                            <th class="d-none d-xl-table-cell">Shërbimet</th>
                            <th class="text-end pe-3 pe-md-4">Pagesa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Data.Count > 0)
                        {
                            foreach (var t in Model.Data.OrderByDescending(x => x.KohaHyrjes))
                            {
                                <tr class="transaksion-row"
                                    style="cursor: pointer;"
                                    data-id="@t.TransaksioniId"
                                    data-njesi-id="@t.Cilsimi?.NjesiOrg?.NjesiteId"
                                    data-njesia="@t.Cilsimi?.NjesiOrg?.Emri"
                                    data-cmimi="@(t.Cmimi ?? 0)"
                                    data-muaji="@t.KohaHyrjes.Month"
                                    data-viti="@t.KohaHyrjes.Year">
                                    <td class="ps-3 ps-md-4">
                                        <span class="fw-bold text-dark">@t.Njesia.Emri</span>
                                    </td>
                                    @if (!User.IsInRole("Customer"))
                                    {
                                        <td class="d-none d-md-table-cell">@t.Useri?.Emri @t.Useri?.Mbiemri</td>
                                    }
                                    <td class="small">@t.KohaHyrjes.ToString("dd/MM/yy HH:mm")</td>
                                    <td class="d-none small d-lg-table-cell">@(t.KohaDaljes.HasValue ? t.KohaDaljes.Value.ToString("dd/MM/yy HH:mm") : "--:--")</td>
                                    <td class="d-none d-sm-table-cell">
                                        <span class="badge @(t.Statusi?.ToLower() == "completed" ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-secondary") rounded-pill">
                                            @t.Statusi
                                        </span>
                                    </td>
                                    <td class="d-none d-xl-table-cell">
                                        @if (t.Sherbimi != null)
                                        {
                                            foreach (var s in t.Sherbimi)
                                            {
                                                <span class="badge bg-light text-dark border fw-normal me-1">@s.Emri</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-end pe-3 pe-md-4 fw-bold text-primary">
                                        @if (t.Cmimi.HasValue && t.Cmimi > 0)
                                        {
                                            @(t.Cmimi.Value.ToString("N2") + " €")
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-success rounded-pill py-0 px-3" onclick="confirmPayment(event, @t.TransaksioniId)">
                                                <i class="bi bi-cash-coin"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center">Nuk u gjet asnjë transaksion</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model != null && Model.TotalPages > 1)
            {
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 p-3 border-top">

                    <div class="text-muted small">
                        Duke shfaqur
                        <strong> @((Model.PageNumber - 1) * Model.PageSize + 1) </strong>
                        -
                        <strong> @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords)) </strong>
                        nga
                        <strong>@Model.TotalRecords</strong>
                        transaksione
                    </div>

                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link rounded-start-pill"
                                    asp-action="Index"
                                    asp-route-pageNumber="@(Model.PageNumber - 1)"
                                    asp-route-pageSize="@Model.PageSize"
                                    asp-route-njesia="@Context.Request.Query["njesia"]">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @{
                                int startPage = Math.Max(1, Model.PageNumber - 2);
                                int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                    asp-action="Index"
                                    asp-route-pageNumber="1"
                                    asp-route-pageSize="@Model.PageSize"
                                    asp-route-njesia="@Context.Request.Query["njesia"]">
                                        1
                                    </a>
                                </li>

                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                    asp-action="Index"
                                    asp-route-pageNumber="@i"
                                    asp-route-pageSize="@Model.PageSize"
                                    asp-route-njesia="@Context.Request.Query["njesia"]">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                
                                <li class="page-item">
                                    <a class="page-link"
                                    asp-action="Index"
                                    asp-route-pageNumber="@Model.TotalPages"
                                    asp-route-pageSize="@Model.PageSize"
                                    asp-route-njesia="@Context.Request.Query["njesia"]">
                                        @Model.TotalPages
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link rounded-end-pill"
                                    asp-action="Index"
                                    asp-route-pageNumber="@(Model.PageNumber + 1)"
                                    asp-route-pageSize="@Model.PageSize"
                                    asp-route-njesia="@Context.Request.Query["njesia"]">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>

                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Shfaq:</span>

                        <select class="form-select form-select-sm"
                                style="width: 80px;"
                                onchange="changePageSize(this.value)">
                            <option value="10" selected="@(Model.PageSize == 10)">10</option>
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100</option>
                        </select>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row g-3 mb-4 mt-2">
        <div class="col-12 col-md-4">
            <div id="btnRaportMuaji" class="card border-0 shadow-sm bg-black text-white h-100 btn-hover-excel transition-up" style="cursor:pointer;">
                <div class="card-body p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75 mb-1">Për këtë Muaj</h6>
                    <h2 class="fw-bold mb-0"><span id="summaryMuaji">@Model.MonthlyAmount.ToString("N2")</span> €</h2>
                    <small class="text-white mt-2 d-block fw-bold opacity-50"><i class="bi bi-download me-1"></i> Shkarko Raportin</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div id="btnRaportViti" class="card border-0 shadow-sm bg-black text-white h-100 btn-hover-excel transition-up" style="cursor:pointer;">
                <div class="card-body p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75 mb-1">Për këtë Vit</h6>
                    <h2 class="fw-bold mb-0"><span id="summaryViti">@Model.YearlyAmount.ToString("N2")</span> €</h2>
                    <small class="text-white mt-2 d-block fw-bold opacity-50"><i class="bi bi-download me-1"></i> Shkarko Raportin</small>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div id="btnRaportGjithsej" class="card border-0 shadow-sm bg-black text-white h-100 btn-hover-excel transition-up" style="cursor:pointer;">
                <div class="card-body p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75 mb-1">Total Gjithsej</h6>
                    <h2 class="fw-bold mb-0"><span id="summaryGjithsej">@Model.TotalAmount.ToString("N2")</span> €</h2>
                    <small class="text-white mt-2 d-block fw-bold opacity-50"><i class="bi bi-download me-1"></i> Shkarko Raportin</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('filterNjesia').addEventListener('change', function() {
            const njesia = this.value;

            const url = new URL(window.location.href);

            url.searchParams.set("pageNumber", "1");

            if (njesia === "" || njesia === "-1") {
                url.searchParams.delete("njesia");
            } else {
                url.searchParams.set("njesia", njesia);
            }

            window.location.href = url.toString();
        });

        function confirmPayment(event, id) {
            event.stopPropagation();
            window.location.href = '@Url.Action("Pay", "Home")?id=' + id;
        }

        function downloadReport(params) {
            const njesiaId = document.getElementById('filterNjesia').value;
            console.log(njesiaId);
            let url = "/LibriShitjes/GetLibri?";
            let queryParts = [];
            for (let key in params) {
                queryParts.push(`${key}=${params[key]}`);
            }
            if (njesiaId && njesiaId != -1) {
                queryParts.push(`njesia=${encodeURIComponent(njesiaId)}`);
            }
            window.location.href = url + queryParts.join('&');
        }

        document.getElementById('btnRaportMuaji').addEventListener('click', function() {
            const now = new Date();
            downloadReport({ month: now.getMonth() + 1, year: now.getFullYear() });
        });

        document.getElementById('btnRaportViti').addEventListener('click', function() {
            downloadReport({ year: new Date().getFullYear() });
        });

        document.getElementById('btnRaportGjithsej').addEventListener('click', function() {
            downloadReport({ all: true });
        });

        document.querySelectorAll('.transaksion-row').forEach(row => {
            row.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                if(id) window.location.href = `/LibriShitjes/GetLibri?id=${id}`;
            });
        });

        function changePageSize(size) {
            const url = new URL(window.location.href);

            url.searchParams.set("pageNumber", "1");
            url.searchParams.set("pageSize", size);

            window.location.href = url.toString();
        }
    </script>
}

<style>
    .transition-up {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-up:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
         }

    .btn-hover-excel:hover {
        background-color: #1a1a1a !important;
    }

    .table-responsive {
        max-height: 70vh;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    thead th {
        position: sticky;
        top: 0;
        background-color: lightgray !important;
        color: #000;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        z-index: 10;
        border-bottom: 2px solid #dee2e6;
    }

    @@media (max-width: 768px) {
        h2 {
            font-size: 1.5rem;
        }

        .card-header h4 {
            font-size: 1.1rem;
        }

        .table {
            font-size: 0.85rem;
        }
     }
</style>