@model Parking_web.Models.DTO.TransaksionRead
@{
    ViewData["Title"] = "Pagesa";

    var kosovoTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Belgrade");
    var entryTime = TimeZoneInfo.ConvertTimeFromUtc(Model.KohaHyrjes, kosovoTimeZone);
    var nowTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, kosovoTimeZone);
}
@if(Model.Statusi != "Pending")
{
    if (User.IsInRole("Super Admin"))
    {
        Context.Response.Redirect(Url.Action("Index", "Organizata")!);
    }
    else if (User.IsInRole("Manager") || User.IsInRole("Employee"))
    {
        Context.Response.Redirect(Url.Action("Employee", "Home")!);
    }
    else if (User.IsInRole("Admin"))
    {
        Context.Response.Redirect(Url.Action("SelectNjesi", "Home")!);
    }
    else
    {
        Context.Response.Redirect(Url.Action("Index", "Home")!);
    }
}

<div class="container py-5">
    <div id="layoutWrapper" class="row justify-content-center qr-active">
        <div id="paymentCol" class="col-md-6 mb-4 position-relative">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden h-100">
                <div class="bg-primary py-4 text-center text-white">
                    <i class="bi bi-wallet2 display-4"></i>
                    <h3 class="fw-bold">Pagesa e Transaksionit</h3>
                    <p class="mb-0 opacity-75">ID e Faturës: #@Model.TransaksioniId</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Vendi i Parkimit:</span>
                        <span class="fw-bold text-end">@Model.Njesia.Emri</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Koha e qëndrimit:</span>
                        <span class="fw-bold">@entryTime.ToString("HH:mm") - @nowTime.ToString("HH:mm")</span>
                    </div>

                    <div class="border-dashed my-4"></div>

                    <div class="text-center mb-4">
                        <h6 class="text-muted text-uppercase small fw-bold">Shuma Totale për të Paguar</h6>
                        <h1 class="display-4 fw-black text-primary">@Model.Cmimi €</h1>
                    </div>

                    @if (User.IsInRole("Customer"))
                    {
                        <div class="border-dashed my-4"></div>
                        <div class="mb-4">
                            <h6 class="text-muted text-center small fw-bold mb-3">Zgjidhni Mënyrën e Pagesës</h6>
                            <div class="card-slider-container">
                                @{
                                    var cards = ViewBag.CardDetails as IEnumerable<Parking_web.Models.DTO.CreditCardReadDto>;
                                }

                                @if (cards != null && cards.Any())
                                {
                                    <div class="d-flex flex-nowrap gap-3 p-1 pb-3" style="overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;">
                                        @foreach (var card in cards)
                                        {
                                            <div class="payment-card-item" data-card-id="@card.Id" onclick="selectCard(this, '@card.Id')" style="flex: 0 0 260px; scroll-snap-align: start; cursor: pointer;">
                                                <div class="p-3 rounded-4 border bg-light text-black shadow-sm position-relative card-visual h-100">
                                                    <div class="d-flex justify-content-between mb-2">
                                                        <i class="bi bi-credit-card text-primary fs-4"></i>
                                                        <span class="bankName small opacity-75">@card.Brand</span>
                                                    </div>
                                                    <div class="mb-3 tracking-widest small text-center py-2">
                                                        **** **** **** @card.Last4
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                                        <span style="font-size: 0.65rem;" class="text-uppercase fw-bold">
                                                            @Model.Useri.Emri @Model.Useri.Mbiemri
                                                        </span>
                                                        <span style="font-size: 0.65rem;">
                                                            @($"{card.ExpMonth:D2}/{card.ExpYear % 100:D2}")
                                                        </span>
                                                    </div>
                                                    <div class="selection-indicator position-absolute top-0 end-0 m-2 d-none">
                                                        <i class="bi bi-check-circle-fill text-primary fs-5"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="d-grid gap-2">
                                    <a asp-controller="Profile" asp-action="Index" class="btn btn-link rounded-pill py-3 text-center">
                                            Shto një kartelë bankare
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                        <input type="hidden" id="selectedCardId" name="selectedCardId" value="" />
                    }

                    <div class="d-grid gap-2">
                        @if (User.IsInRole("Manager") || User.IsInRole("Admin") || User.IsInRole("Employee"))
                        {
                            <form asp-action="CashPayment" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.TransaksioniId" />

                                <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 shadow">Paguaj Cash </button>
                            </form>
                            <a asp-action="Edit" asp-route-transaksioniId="@Model.TransaksioniId" class="btn btn-outline-primary btn-lg w-100 rounded-pill fw-bold py-3 shadow">Shërbimet Shtesë</a>

                            <a asp-action="Employee" asp-route-njesia="@Model.Njesia.NjesiteId" class="btn btn-link text-muted text-decoration-none text-center rounded-pill pt-3 ">Anulo dhe kthehu</a>
                        }
                        else if (Model.Njesia.QRScanner)
                        {
                            <form asp-action="QRShow" method="get" id="paymentForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.TransaksioniId" />
                                <input type="hidden" name="selectedCardId" id="selectedCardInput" />

                                <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 shadow" disabled>Zgjedh për pagesë </button>

                                <div id="selectionWarning" class="text-danger small text-center mt-2">
                                    <i class="bi bi-info-circle"></i> Ju lutem zgjidhni një kartelë për të vazhduar.
                                </div>
                            </form>
                            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none text-center rounded-pill pt-3 ">Anulo dhe kthehu</a>
                        }
                        else
                        {
                            <input type="hidden" name="selectedCardId" id="selectedCardInput" />
                            <button type="button" onclick="openCamera()" id="submitBtn" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 shadow" disabled>Zgjedh për pagesë </button>
                            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none text-center rounded-pill pt-3 ">Anulo dhe kthehu</a>
                        }
                    </div>
                </div>
            </div>

            <div class="sherbime-tab shadow-sm" onclick="toggleQR()">
                <span>Shërbime</span>
            </div>
        </div>

        @if (User.IsInRole("Customer"))
        {
            
            <div id="qrCol" class="col-md-5 mb-4 position-relative d-block d-md-none">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden h-100 position-relative">
                    <div class="bg-primary py-4 text-center text-white position-relative">
                        <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 d-none d-md-block" onclick="toggleQR()" aria-label="Close"></button>
                        <i class="bi bi-qr-code-scan display-4"></i>
                        <h3 class="fw-bold">Shërbime Shtesë</h3>
                        <p class="mb-0 opacity-0">.</p>
                    </div>

                    <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                        <p class="text-muted mb-4">Tregoja kodin e mëposhtëm punëtorëve të parkingut për të shtuar shërbime të reja në këtë faturë.</p>

                        <div id="qr-to-print" class="qr-container my-auto p-3 bg-white border rounded-4 d-inline-block mx-auto shadow-sm">
                            <img id="qrImageDisplay" src="@Url.Action("QRGenerate", "Home", new { id = Model.TransaksioniId })"
                                 alt="QR Code"
                                 class="img-fluid qr-image" />
                        </div>
                    
                        <div class="mt-4 opacity-50 small">
                            <i class="bi bi-shield-check"></i> Kod i siguruar për ID #@Model.TransaksioniId
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="modal fade" id="cameraModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-qr-code-scan me-2"></i>
                        Skano QR Kodin
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="stopCamera()"> </button>
                </div>
                <div class="modal-body">
                    <div id="qr-reader" style="width: 100%;"></div>
                    <div id="qr-loading" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">
                                Loading...
                            </span>
                        </div>
                        <div class="fw-semibold">
                            Duke verifikuar QR kodin...
                        </div>
                        <small class="text-muted">
                            Ju lutem prisni
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .sherbime-tab {
        position: absolute;
        right: -30px;
        top: 50px;
        background: white;
        border: 1px solid #0d6efd;
        border-left: none;
        padding: 15px 8px;
        cursor: pointer;
        border-radius: 0 12px 12px 0;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        font-weight: bold;
        color: #0d6efd;
        z-index: 5;
        display: none;
        transition: all 0.2s;
    }

    sherbime-tab:hover { background: #0d6efd; color: white; }

    .qr-image {
        display: block;
        width: 100%;
        max-width: 300px;
        height: auto;
        margin: 0 auto;
        border: 10px solid white;
        box-sizing: border-box;
    }

    #layoutWrapper:not(.qr-active) #qrCol { display: none; }
    #layoutWrapper:not(.qr-active) .sherbime-tab { display: block; }
    #layoutWrapper.qr-active #qrCol { display: block; }

    .fw-black { font-weight: 900; }
    .border-dashed { border-top: 2px dashed #dee2e6; position: relative; margin: 0 -3rem; }
    .border-dashed::before, .border-dashed::after { content: ""; position: absolute; top: -11px; width: 22px; height: 22px; background-color: #f8f9fa; border-radius: 50%; }
    .border-dashed::before { left: -11px; } .border-dashed::after { right: -11px; }
    
    .bg-primary { 
        background: linear-gradient(45deg, #0d6efd, #0a58ca) !important; 
    }

    .card-visual { transition: all 0.3s ease; border: 2px solid transparent !important; }
    .payment-card-item.active .card-visual { border-color: #0d6efd !important; transform: scale(1.02); box-shadow: 0 5px 15px rgba(13, 110, 253, 0.2) !important; }
    .payment-card-item.active .selection-indicator { display: block !important; }
    .payment-card-item.active .bankName { margin-right: 1rem; }
    .tracking-widest { letter-spacing: 2px; }

    @@media (min-width: 768px) {
        #layoutWrapper:not(.qr-active) #qrCol {
            display: none !important;
        }

        #layoutWrapper:not(.qr-active) .sherbime-tab {
            display: block !important;
        }

        #layoutWrapper.qr-active #qrCol {
            display: block !important;
        }
    }

    @@media (max-width: 767.98px) {
        #qrCol {
            display: block !important;
        }
        .sherbime-tab {
            display: none !important;
        }
    }

    @@media print {
        body * { visibility: hidden; }
        #qr-to-print, #qr-to-print * { visibility: visible; }
        #qr-to-print { position: absolute; left: 0; top: 1cm; width: 100%; text-align: center; }
    }
</style>
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const wrapper = document.getElementById('layoutWrapper');
        const qrState = sessionStorage.getItem("qrActive");
        const isCustomer = @User.IsInRole("Customer").ToString().ToLowerInvariant();

        if (!isCustomer) {
            wrapper.classList.add('qr-active');
        }
        else{
            if (qrState === "false") {
                wrapper.classList.remove('qr-active');
            } else if (qrState === "true") {
                wrapper.classList.add('qr-active');
            }
        }

        const savedCardId = sessionStorage.getItem("selectedCardId");
        if (savedCardId) {
            const cardElement = document.querySelector(`[data-card-id="${savedCardId}"]`);
            if (cardElement) {
                selectCard(cardElement, savedCardId);
            }
        }
    });

    function toggleQR() {
        const wrapper = document.getElementById('layoutWrapper');
        wrapper.classList.toggle('qr-active');
        sessionStorage.setItem("qrActive", wrapper.classList.contains('qr-active'));
    }

    function selectCard(element, cardId) {
        document.querySelectorAll('.payment-card-item').forEach(item => item.classList.remove('active'));

        element.classList.add('active');

        
        const cardInput = document.getElementById('selectedCardInput');
        const submitBtn = document.getElementById('submitBtn');
        const warning = document.getElementById('selectionWarning');

        if(cardInput) cardInput.value = cardId;

        if (submitBtn) submitBtn.disabled = false;
        if (warning) warning.classList.add('d-none');

        sessionStorage.setItem("selectedCardId", cardId);
    }

    
    let qrScanner = null;
    let qrProcessing = false;

    async function openCamera() {
        const modalElement = document.getElementById("cameraModal");
        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
        modal.show();

        qrProcessing = false;

        document.getElementById("qr-reader").classList.remove("d-none");
        document.getElementById("qr-loading").classList.add("d-none");

        setTimeout(async () => {
            try {
                await stopCamera();
                qrScanner = new Html5Qrcode("qr-reader");

                await qrScanner.start(
                    { facingMode: "environment" },
                    {
                        fps: 10,
                        qrbox: {
                            width: 250,
                            height: 250
                        }
                    },
                    async (decodedText) => {
                        if (qrProcessing) {
                            return;
                        }
                            qrProcessing = true;

                        document.getElementById("qr-reader").classList.add("d-none");
                        document.getElementById("qr-loading").classList.remove("d-none");

                        await stopCamera();
                        await handleQrCode(decodedText);
                    },
                    (errorMessage) => { }
                );
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Gabim!',
                    text: 'Nuk mund të hapet kamera. Kontrolloni lejen për përdorimin e kamerës.',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Kuptova'
                });
                modal.hide();
            }
        }, 300);
    }
    async function stopCamera() {
        if (qrScanner) {
            try {
                await qrScanner.stop();
                await qrScanner.clear();
            } catch (error) {
                console.error("Error stopping camera:", error);
            }

            qrScanner = null;
        }
    }
    async function handleQrCode(value) {
        try {
            const cardId = document.getElementById('selectedCardInput').value;
            const response = await fetch(
                `/Home/QRReader?encrypted=${encodeURIComponent(value)}&njesiaId=${@Model.Njesia.NjesiteId}&id=${@Model.TransaksioniId}&cardId=${cardId}&type=Exit`,
                {
                    method: "GET",
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );
            console.log(response);
            const result = await response.json();
            console.log(result);

            if (result.success) {
                const modalElement = document.getElementById("cameraModal");
                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.hide();

                Swal.fire({
                    icon: "success",
                    title: "QR i vlefshëm",
                    text: "QR kodi u verifikua me sukses.",
                    timer: 1500,
                    showConfirmButton: false,
                    timerProgressBar: true
                });

                window.location.href = `/Home/Index`;

            } else {
                const modalElement = document.getElementById("cameraModal");
                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.hide();

                await Swal.fire({
                    icon: "error",
                    title: "QR i pavlefshëm",
                    text: result.message ?? "Ka ndodhue një gabim",
                    confirmButtonText: "Kuptova"
                });

                qrProcessing = false;
            }
        } catch (error) {
            console.error("QR validation error:", error);

            const modalElement = document.getElementById("cameraModal");
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            modal.hide();

            await Swal.fire({
                icon: "error",
                title: "Gabim!",
                text: "Ndodhi një gabim gjatë verifikimit të QR kodit.",
                confirmButtonText: "Kuptova"
            });

            qrProcessing = false;
        }
    }
</script>