@using Parking_web.Models.DTO
@model OrgPage
@{
    ViewData["Title"] = "Menaxhimi i Organizatave";

    var currentSearch = Context.Request.Query["Search"].ToString();
    var currentPageSize = Model?.PageSize ?? 10;
    var currentPage = Model?.PageNumber ?? 1;
    var totalPages = Model?.TotalPages ?? 0;
}

<style>
    .btn-edit-custom {
        color: #ffc107;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }

        .btn-edit-custom:hover {
            border-color: #ffc107 !important;
            background-color: rgba(255, 193, 7, 0.1);
            color: #ba8b00;
        }

    .btn-delete-custom {
        color: #dc3545;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }

        .btn-delete-custom:hover {
            border-color: #dc3545 !important;
            background-color: rgba(220, 53, 69, 0.1);
            color: #a71d2a;
        }

    .btn-activate-custom {
        color: #0d6efd;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }

        .btn-activate-custom:hover {
            border-color: #0d6efd !important;
            background-color: rgba(13, 110, 253, 0.1);
            color: #0a58ca;
        }

    .pagination .page-link {
        border: none;
        margin: 0 2px;
        border-radius: 10px;
        min-width: 38px;
        text-align: center;
        color: black;
    }

        .pagination .page-item.active .page-link {
            background: black;
            color: #fff;
        }

    .card-header-main {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem 1.25rem;
    }

    @@media (min-width: 576px) {
        .card-header-main {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.5rem;
        }
    }

    .search-box .input-group-text {
        border-top-left-radius: 50rem !important;
        border-bottom-left-radius: 50rem !important;
        padding-left: 1rem;
    }

    .search-box .form-control {
        border-top-right-radius: 50rem !important;
        border-bottom-right-radius: 50rem !important;
        padding-right: 1rem;
    }

        .search-box .form-control:focus {
            box-shadow: none;
            border-color: #dee2e6;
        }
</style>

<div class="container-fluid px-2 px-sm-4 my-3 my-sm-5 pb-5">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-black text-white p-0">
            <div class="card-header-main">
                <div>
                    <h4 class="fw-bold mb-1 text-white fs-5 fs-sm-4">Regjistri i Organizatave</h4>
                    <small class="opacity-75 d-block">Administrimi i bizneseve dhe kontakteve</small>
                </div>
                <div>
                    <a asp-controller="Organizata" asp-action="Create" class="btn btn-outline-light btn-sm px-3 px-sm-4 rounded-pill fw-semibold w-100 w-sm-auto">
                        <i class="bi bi-plus-lg me-1"></i> Shto Organizatë
                    </a>
                </div>
            </div>
        </div>

        <div class="p-3 bg-white border-bottom">
            <form method="get" asp-controller="Organizata" asp-action="Index">
                <input type="hidden" name="pageSize" value="@currentPageSize" />
                <div class="row g-3 align-items-center justify-content-between">
                    <div class="col-12 col-md-8 col-lg-6">
                        <div class="input-group search-box">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="Search" value="@currentSearch" class="form-control bg-light border-start-0" placeholder="Kërko sipas emrit apo lokacionit..." />
                            @if (!string.IsNullOrEmpty(currentSearch))
                            {
                                <a asp-controller="Organizata" asp-action="Index" class="btn btn-white border-0 text-muted d-flex align-items-center">
                                    <i class="bi bi-x-circle-fill"></i>
                                </a>
                            }
                            <button type="submit" class="btn btn-dark px-3 px-sm-4 rounded-pill ms-1 ms-sm-2 fw-semibold">Kërko</button>
                        </div>
                    </div>
                    <div class="col-12 col-md-auto text-muted small text-md-end">
                        Gjithsej: <span class="fw-bold text-dark">@(Model?.TotalRecords ?? 0)</span> organizata
                    </div>
                </div>
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3 ps-sm-4 text-uppercase small fw-bold text-muted">Biznesi</th>
                            <th class="text-uppercase small fw-bold text-muted">ID & Fiskal</th>
                            <th class="text-uppercase small fw-bold text-muted d-none d-sm-table-cell">Lokacioni</th>
                            <th class="text-uppercase small fw-bold text-muted d-none d-md-table-cell">Lejon Klientë</th>
                            <th class="text-uppercase small fw-bold text-muted d-none d-lg-table-cell">Kontakti</th>
                            <th class="text-end pe-3 pe-sm-4 text-uppercase small fw-bold text-muted">Veprimet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Data != null && Model.Data.Any())
                        {
                            foreach (var org in Model.Data)
                            {
                                <tr>
                                    <td class="ps-3 ps-sm-4">
                                        <div class="fw-bold text-dark">@org.EmriBiznesit</div>
                                        <div class="small text-muted">@org.Adresa</div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">UID: @org.NumriUnikIdentifikues</div>
                                        <div class="small text-muted">Fiskal: @org.NumriFiskal</div>
                                    </td>
                                    <td class="d-none d-sm-table-cell">
                                        <span class="badge bg-light text-dark border rounded-pill px-2 px-sm-3 fw-normal">
                                            <i class="bi bi-geo-alt text-primary me-1"></i>@org.Komuna
                                        </span>
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        <div class="text-muted">
                                            @if (org.AllowCustomers)
                                            {
                                                <i class="bi bi-check-circle-fill text-success fw-bold me-1"> Lejuar</i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-danger fw-bold me-1"> Ndaluar</i>
                                            }
                                        </div>
                                    </td>
                                    <td class="d-none d-lg-table-cell">
                                        <div class="small fw-bold text-dark"><i class="bi bi-telephone me-1 text-muted"></i>@org.Telefoni</div>
                                        <div class="small text-muted">@org.Email</div>
                                    </td>
                                    <td class="text-end pe-3 pe-sm-4">
                                        <div class="d-none d-lg-inline-flex align-items-center">
                                            @if (ViewBag.OrgId != null && ViewBag.OrgId == org.BiznesId)
                                            {
                                                <form asp-action="Activate" asp-route-orgId="@org.BiznesId" asp-route-activate="false" method="post" class="d-inline me-1">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-activate-custom fw-semibold">Deaktivizo</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activate" asp-route-orgId="@org.BiznesId" asp-route-activate="true" method="post" class="d-inline me-1">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-activate-custom fw-semibold">Aktivizo</button>
                                                </form>
                                            }

                                            <a asp-action="Edit" asp-route-id="@org.BiznesId" class="btn btn-sm btn-edit-custom fw-semibold me-1">Përditëso</a>
                                            <a asp-action="Delete" asp-route-id="@org.BiznesId" class="btn btn-sm btn-delete-custom fw-semibold">Fshije</a>
                                        </div>

                                        <div class="dropdown d-lg-none">
                                            <button class="btn btn-sm btn-light border-0 px-2 text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Më shumë veprime">
                                                <i class="bi bi-three-dots-vertical fs-6"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    @if (ViewBag.OrgId != null && ViewBag.OrgId == org.BiznesId)
                                                    {
                                                        <form asp-action="Activate" asp-route-orgId="@org.BiznesId" asp-route-activate="false" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item text-primary fw-medium py-3">
                                                                <i class="bi bi-check2-circle me-2"></i>Deaktivizo
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="Activate" asp-route-orgId="@org.BiznesId" asp-route-activate="true" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item text-primary fw-medium py-3">
                                                                <i class="bi bi-check2-circle me-2"></i>Aktivizo
                                                            </button>
                                                        </form>
                                                    }
                                                </li>
                                                <li>
                                                    <a asp-action="Edit" asp-route-id="@org.BiznesId" class="dropdown-item text-warning fw-medium py-3">
                                                        <i class="bi bi-pencil me-2"></i>Përditëso
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-action="Delete" asp-route-id="@org.BiznesId" class="dropdown-item text-danger fw-medium py-3">
                                                        <i class="bi bi-trash me-2"></i>Fshije
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="bi bi-building-exclamation text-muted d-block mb-2" style="font-size: 2.5rem;"></i>
                                    <span class="text-muted fw-bold">Nuk u gjet asnjë organizatë në sistem.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model != null && Model.TotalPages > 0)
        {
            <div class="card-footer bg-white py-3 border-top-0">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <div class="text-muted small">
                        Duke shfaqur
                        <strong> @((Model.PageNumber - 1) * Model.PageSize + 1) </strong>
                        -
                        <strong> @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords)) </strong>
                        nga
                        <strong>@Model.TotalRecords</strong>
                        transaksione
                    </div>
                    

                    @if (Model.TotalPages > 1)
                    {
                        <div class="d-flex gap-1 align-items-center flex-wrap justify-content-center">
                            <ul class="pagination mb-0">
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link rounded-start-pill"
                                       asp-controller="Organizata"
                                       asp-action="Index"
                                       asp-route-Search="@currentSearch"
                                       asp-route-page="@(currentPage - 1)"
                                       asp-route-pageSize="@currentPageSize">

                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                @{
                                    int startPage = Math.Max(1, currentPage - 2);
                                    int endPage = Math.Min(totalPages, currentPage + 2);
                                }
                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           asp-controller="Organizata"
                                           asp-action="Index"
                                           asp-route-Search="@currentSearch"
                                           asp-route-page="1"
                                           asp-route-pageSize="@currentPageSize">
                                            1
                                        </a>
                                    </li>

                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-controller="Organizata"
                                           asp-action="Index"
                                           asp-route-Search="@currentSearch"
                                           asp-route-page="@i"
                                           asp-route-pageSize="@currentPageSize">

                                            @i
                                        </a>
                                    </li>
                                }

                                @if (endPage < totalPages)
                                {
                                    @if (endPage < totalPages - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }

                                    <li class="page-item">
                                        <a class="page-link"
                                           asp-controller="Organizata"
                                           asp-action="Index"
                                           asp-route-Search="@currentSearch"
                                           asp-route-page="@totalPages"
                                           asp-route-pageSize="@currentPageSize">

                                            @totalPages
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link rounded-end-pill"
                                       asp-controller="Organizata"
                                       asp-action="Index"
                                       asp-route-Search="@currentSearch"
                                       asp-route-page="@(currentPage + 1)"
                                       asp-route-pageSize="@currentPageSize">

                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Shfaq:</span>
                        <select class="form-select form-select-sm rounded-3" style="width: 75px;" onchange="changePageSize(this.value)">
                            <option value="5" selected="@(currentPageSize == 5)">5</option>
                            <option value="10" selected="@(currentPageSize == 10)">10</option>
                            <option value="20" selected="@(currentPageSize == 20)">20</option>
                            <option value="50" selected="@(currentPageSize == 50)">50</option>
                        </select>
                        <span class="text-muted small">për faqe</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function changePageSize(size) {
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('pageSize', size);
            urlParams.set('page', '1');
            window.location.search = urlParams.toString();
        }
    </script>
}