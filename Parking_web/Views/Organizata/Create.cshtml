@model Parking_web.Models.DTO.OrgCreateDTO
@{
    ViewData["Title"] = "Krijimi i Organizatës";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold">Regjistro Organizatë të Re</h5>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="EmriBiznesit" class="form-label fw-semibold">Emri i Biznesit</label>
                            <input asp-for="EmriBiznesit" class="form-control" placeholder="Shkruani emrin zyrtar" />
                            <span asp-validation-for="EmriBiznesit" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NumriUnikIdentifikues" class="form-label fw-semibold">NUI (Numri Unik)</label>
                                <input asp-for="NumriUnikIdentifikues" class="form-control" />
                                <span asp-validation-for="NumriUnikIdentifikues" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="NumriBiznesit" class="form-label fw-semibold">Numri i Biznesit</label>
                                <input asp-for="NumriBiznesit" class="form-control" />
                                <span asp-validation-for="NumriBiznesit" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NumriFiskal" class="form-label fw-semibold">Numri Fiskal</label>
                                <input asp-for="NumriFiskal" class="form-control" />
                                <span asp-validation-for="NumriFiskal" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="NumriPunetoreve" class="form-label fw-semibold">Numri i Punëtorëve</label>
                                <input asp-for="NumriPunetoreve" type="number" class="form-control" />
                                <span asp-validation-for="NumriPunetoreve" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Adresa" class="form-label fw-semibold">Adresa</label>
                                <input asp-for="Adresa" class="form-control" placeholder="Rruga dhe numri" />
                                <span asp-validation-for="Adresa" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Komuna" class="form-label fw-semibold">Komuna</label>
                                <input asp-for="Komuna" class="form-control" placeholder="Qyteti" />
                                <span asp-validation-for="Komuna" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Telefoni" class="form-label fw-semibold">Telefoni</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Telefoni" class="form-control" placeholder="+383..." />
                                </div>
                                <span asp-validation-for="Telefoni" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Email" class="form-label fw-semibold">Email Adresa</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="emri@shembull.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <div class="form-check form-switch">
                                    <input asp-for="AllowCustomers" class="form-check-input" type="checkbox" role="switch" id="allowCustomers" value="true"/>

                                    <label asp-for="AllowCustomers" class="form-check-label fw-semibold" for="allowCustomers">
                                        Lejo klientët
                                    </label>
                                </div>

                                <small class="text-muted">
                                    Aktivizoni këtë opsion nëse kjo organizatë lejon krijimin dhe përdorimin e llogarive të klientëve.
                                </small>

                                <span asp-validation-for="AllowCustomers" class="text-danger small d-block"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end border-top pt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Anulo</a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm">
                                Krijo Organizatën
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
