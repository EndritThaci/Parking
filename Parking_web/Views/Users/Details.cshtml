@model Parking_web.Models.DTO.UserTotalsDTO

@{
    ViewData["Title"] = "User Details";
    var firstName = Model.User?.Emri ?? "N/A";
    var lastName = Model.User?.Mbiemri ?? "";
    var initial = !string.IsNullOrEmpty(firstName) && firstName != "N/A" ? firstName[0].ToString().ToUpper() : "U";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold mb-0">Përmbledhja e Përdoruesit</h2>
            <p class="text-muted small mb-0">Përmbledhje e aktivitetit të përdoruesit dhe e shumave financiare</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Kthehu
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 text-center">
                    <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 72px; height: 72px; font-size: 1.75rem;">
                        @initial
                    </div>
                    <h5 class="fw-bold mb-1">@firstName @lastName</h5>
                    <hr class="my-3 opacity-10" />

                    <div class="text-start small text-muted">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Emaili:</span>
                            <strong class="text-dark">@(Model.User?.Email ?? "N/A")</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Roli:</span>
                            @if (Model.User?.Role == "Admin")
                            {
                                <span class="badge bg-danger-subtle border border-danger text-danger rounded-pill px-3">
                                    Admin
                                </span>
                            }
                            else if (Model.User?.Role == "Manager")
                            {
                                <span class="badge bg-warning-subtle border border-warning text-warning-emphasis rounded-pill px-3">
                                    Menaxher
                                </span>
                            }
                            else if (Model.User?.Role == "Employee")
                            {
                                <span class="badge bg-info-subtle border border-info text-info rounded-pill px-3">
                                    Punëtorë
                                </span>
                            }
                            else if (Model.User?.Role == "Customer")
                            {
                                <span class="badge bg-primary-subtle border border-primary text-primary rounded-pill px-3">
                                    Klientë
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle border border-secondary text-secondary rounded-pill px-3">
                                    @Model.User?.Role
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 bg-primary text-white shadow-sm mb-4">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50 text-uppercase fw-semibold mb-1">Totali i të ardhurave</h6>
                        <h2 class="display-6 fw-bold mb-0">€@Model.Total.AmountAll.ToString("N2")</h2>
                    </div>
                    <div class="text-end">
                        <h6 class="text-white-50 text-uppercase fw-semibold mb-1">Total Transaksione</h6>
                        <h3 class="fw-bold mb-0">@Model.Total.CountAll</h3>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <span class="text-muted fw-semibold small text-uppercase mb-1">Sot</span>
                        <h5 class="fw-bold mb-1 text-primary">@Model.Total.AmountToday.ToString("N2")€</h5>
                        <small class="text-muted">@Model.Total.CountToday transaksione</small>
                    </div>
                </div>

                <div class="col-sm-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <span class="text-muted fw-semibold small text-uppercase mb-1">Këtë Javë</span>
                        <h5 class="fw-bold mb-1 text-primary">@Model.Total.AmountWeek.ToString("N2")€</h5>
                        <small class="text-muted">@Model.Total.CountWeek transaksione</small>
                    </div>
                </div>

                <div class="col-sm-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <span class="text-muted fw-semibold small text-uppercase mb-1">Këtë Muaj</span>
                        <h5 class="fw-bold mb-1 text-primary">@Model.Total.AmountMonth.ToString("N2")€</h5>
                        <small class="text-muted">@Model.Total.CountMonth transaksione</small>
                    </div>
                </div>

                <div class="col-sm-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <span class="text-muted fw-semibold small text-uppercase mb-1">Këtë Vitë</span>
                        <h5 class="fw-bold mb-1 text-primary">@Model.Total.AmountYear.ToString("N2")€</h5>
                        <small class="text-muted">@Model.Total.CountYear transaksione</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>