@model Parking_web.Models.DTO.TransaksionPage
@{
    ViewData["Title"] = "Transaksionet";
}

<div class="container-fluid px-0 px-md-2">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-black text-white pt-4 px-3 px-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-3">
                <div>
                    <h4 class="fw-bold mb-0">Historia e Transaksioneve</h4>
                    <small class="opacity-75">Regjistri i hyrjeve dhe daljeve</small>
                </div>
                <div class="action-button-area">
                    <a asp-controller="LibriShitjes" asp-action="GetLibriCustom" class="btn btn-outline-light px-4 rounded-pill fw-bold w-100 w-md-auto">
                        Gjenero Librin e Shitjes
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive custom-scrollbar">
                <table class="table table-hover align-middle mb-0 w-100" id="transaksionetTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3 ps-md-4">Vend Parkimi</th>
                            <th class="d-none d-lg-table-cell">Perdoruesi</th>
                            <th>Hyrja</th>
                            <th class="d-none d-md-table-cell">Dalja</th>
                            <th class="d-none d-sm-table-cell">Statusi</th>
                            <th class="d-none d-xl-table-cell">Shërbimet</th>
                            <th class="text-end pe-3 pe-md-4">Pagesa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var t in Model.Data.OrderByDescending(x => x.KohaHyrjes))
                            {
                                <tr class="transaksion-row"
                                    style="cursor: pointer;"
                                    data-id="@t.TransaksioniId"
                                    data-njesia="@t.Cilsimi?.NjesiOrg?.Emri"
                                    data-cmimi="@(t.Cmimi ?? 0)"
                                    data-muaji="@t.KohaHyrjes.Month"
                                    data-viti="@t.KohaHyrjes.Year">
                                    <td class="ps-3 ps-md-4">
                                        <span class="fw-bold text-dark">@t.Njesia.Emri</span>
                                    </td>
                                    <td class="d-none d-lg-table-cell text-muted">@t.Useri?.Emri @t.Useri?.Mbiemri</td>
                                    <td class="text-nowrap small">@t.KohaHyrjes.ToString("dd/MM/yy HH:mm")</td>
                                    <td class="d-none d-md-table-cell small">@(t.KohaDaljes.HasValue ? t.KohaDaljes.Value.ToString("dd/MM/yy HH:mm") : "--:--")</td>
                                    <td class="d-none d-sm-table-cell">
                                        <span class="badge @(t.Statusi?.ToLower() == "completed" ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-secondary") rounded-pill px-3">
                                            @t.Statusi
                                        </span>
                                    </td>
                                    <td class="d-none d-xl-table-cell">
                                        @if (t.Sherbimi != null)
                                        {
                                            foreach (var s in t.Sherbimi)
                                            {
                                                <span class="badge bg-light text-dark border fw-normal me-1">@s.Emri</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-end pe-3 pe-md-4 fw-bold text-primary">
                                        @if (t.Cmimi.HasValue && t.Cmimi > 0)
                                        {
                                            <span>@(t.Cmimi.Value.ToString("N2")) €</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fw-normal small">Në proces</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (Model != null && Model.TotalPages > 1)
            {
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 p-3 border-top">

                    <div class="text-muted small">
                        Duke shfaqur
                        <strong> @((Model.PageNumber - 1) * Model.PageSize + 1) </strong>
                        -
                        <strong> @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords)) </strong>
                        nga
                        <strong>@Model.TotalRecords</strong>
                        transaksione
                    </div>

                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="IndexManager"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @{
                                int startPage = Math.Max(1, Model.PageNumber - 2);
                                int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="IndexManager"
                                       asp-route-pageNumber="1"
                                       asp-route-pageSize="@Model.PageSize">
                                        1
                                    </a>
                                </li>

                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="IndexManager"
                                       asp-route-pageNumber="@i"
                                       asp-route-pageSize="@Model.PageSize">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }

                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="IndexManager"
                                       asp-route-pageNumber="@Model.TotalPages"
                                       asp-route-pageSize="@Model.PageSize">
                                        @Model.TotalPages
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="IndexManager"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>

                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Shfaq:</span>

                        <select class="form-select form-select-sm"
                                style="width: 80px;"
                                onchange="changePageSize(this.value)">
                            <option value="10" selected="@(Model.PageSize == 10)">10</option>
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100</option>
                        </select>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row g-3 mb-4 mt-2 mt-md-4">
        <div class="col-12 col-md-4">
            <a asp-controller="LibriShitjes" asp-action="GetLibri" asp-route-month="@DateTime.Now.Month" asp-route-year="@DateTime.Now.Year" class="text-decoration-none transition-up">
                <div class="card border-0 shadow-sm bg-black text-white h-100 btn-hover-excel">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase small fw-bold opacity-75 mb-1">Këtë Muaj</h6>
                        <h2 class="fw-bold mb-0">@Model.MonthlyAmount.ToString("N2") €</h2>
                        <small class="text-white mt-2 d-block fw-bold"><i class="bi bi-download me-1"></i> Raporti</small>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a asp-controller="LibriShitjes" asp-action="GetLibri" asp-route-year="@DateTime.Now.Year" class="text-decoration-none transition-up">
                <div class="card border-0 shadow-sm bg-black text-white h-100 btn-hover-excel">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase small fw-bold opacity-75 mb-1">Këtë Vit</h6>
                        <h2 class="fw-bold mb-0">@Model.YearlyAmount.ToString("N2") €</h2>
                        <small class="text-white mt-2 d-block fw-bold"><i class="bi bi-download me-1"></i> Raporti</small>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a asp-controller="LibriShitjes" asp-action="GetLibri" asp-route-all="true" class="text-decoration-none transition-up">
                <div class="card border-0 shadow-sm bg-black text-white h-100 btn-hover-excel">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase small fw-bold opacity-75 mb-1">Gjithsej</h6>
                        <h2 class="fw-bold mb-0">@Model.TotalAmount.ToString("N2") €</h2>
                        <small class="text-white mt-2 d-block fw-bold"><i class="bi bi-download me-1"></i> Raporti</small>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.transaksion-row').forEach(row => {
        row.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            if(id) {
                window.location.href = `/LibriShitjes/GetLibri?id=${id}`;
            }
        });
    });

    function changePageSize(size) {
        const url = new URL(window.location.href);

        url.searchParams.set("pageNumber", "1");
        url.searchParams.set("pageSize", size);

        window.location.href = url.toString();
    }
</script>

<style>
    .transition-up {
        transition: transform 0.2s ease-in-out;
        display: block;
    }

        .transition-up:hover {
            transform: translateY(-5px);
        }

    .btn-hover-excel {
        border: 1px solid transparent !important;
        transition: all 0.3s ease;
    }

        .btn-hover-excel:hover {
            background-color: #1a1a1a !important;
        }

    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    thead th {
        position: sticky;
        top: 0;
        background-color: lightgray !important;
        z-index: 2;
        box-shadow: inset 0 -1px 0 #dee2e6;
        white-space: nowrap;
    }


    @@media (max-width: 576px) {
        h4 {
            font-size: 1.1rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        .table {
            font-size: 0.85rem;
        }
    }
</style>