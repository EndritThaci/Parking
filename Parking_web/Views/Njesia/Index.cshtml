@using Parking_web.Models.DTO
@model IEnumerable<NjesiReadDto>
@{
    ViewData["Title"] = "Menaxhimi i Njësive";
}

<style>
    .btn-edit-custom {
        color: #ffc107;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }

        .btn-edit-custom:hover {
            border-color: #ffc107 !important;
            background-color: rgba(255, 193, 7, 0.1);
            color: #ba8b00;
        }

    .btn-delete-custom {
        color: #dc3545;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }

        .btn-delete-custom:hover {
            border-color: #dc3545 !important;
            background-color: rgba(220, 53, 69, 0.1);
            color: #a71d2a;
        }

    .btn-activate-custom {
        color: #0d6efd;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }

        .btn-activate-custom:hover {
            border-color: #0d6efd !important;
            background-color: rgba(13, 110, 253, 0.1);
            color: #0a58ca;
        }

    .card-header {
        padding: 0 !important;
        overflow: hidden;
        position: relative;
    }

    .header-content {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 1rem 1.5rem;
    }

    .clickable-title {
        cursor: pointer;
        flex-grow: 1;
        display: flex;
        align-items: center;
        z-index: 1;
    }
    
    .clickable-row {
        cursor: pointer;
    }

    .btn-minimize i {
        display: inline-block;
        transition: transform 0.3s ease-in-out;
    }

    .collapsed .btn-minimize i {
        transform: rotate(-90deg);
    }

    .table-responsive {
        border: none;
    }

    .text-nowrap-mobile {
        white-space: nowrap;
    }

    @@media (max-width: 576px) {
        .header-content {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .action-button-area {
            width: 100%;
        }

            .action-button-area .btn {
                width: 100%;
            }
    }
</style>

<div class="container my-4 my-md-5 pb-5">

    @if (User.IsInRole("Manager"))
    {
        <div class="header-content">
            <div>
                <h2 class="fw-bold text-dark mb-1">Menaxhimi i Njesisë @Model.FirstOrDefault().Emri</h2>
                <p class="text-muted small">Kontrolloni sherbimet dhe cilësimet tuaja në një vend.</p>
            </div>
            @if (!Model.FirstOrDefault().QRScanner && ViewBag.customers)
            {
                <div>
                    <a asp-action="NjesiaQR" asp-route-id="@ViewBag.NjesiaId" class="btn btn-outline-primary btn-sm px-4 rounded-pill fw-semibold"><i class="bi bi-qr-code-scan"></i> QR Kodi</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row align-items-center mb-4 px-3 px-md-0">
            <div class="col-12">
                <h2 class="fw-bold text-dark mb-1">Menaxhimi i Organizatës</h2>
                <p class="text-muted small">Kontrolloni njësitë, shërbimet dhe cilësimet tuaja në një vend.</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4 mb-md-5 mx-2 mx-md-0">
            <div class="card-header bg-black text-white">
                <div class="header-content">
                    <div class="clickable-title" data-bs-toggle="collapse" data-bs-target="#collNjesite">
                        <span class="btn-minimize me-3"><i class="bi bi-chevron-down"></i></span>
                        <div>
                            <h5 class="fw-bold mb-0 text-white">Menaxhimi i Njësive</h5>
                            <small class="opacity-75 d-none d-sm-block">Lista e pikave aktive</small>
                        </div>
                    </div>
                    <div class="action-button-area">
                        <a asp-controller="Njesia" asp-action="Create" class="btn btn-outline-light btn-sm px-4 rounded-pill fw-semibold">Shto Njësi</a>
                    </div>
                </div>
            </div>
            <div id="collNjesite" class="collapse show">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 w-100">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Emri</th>
                                    <th class="d-none d-md-table-cell">Kodi</th>
                                    <th class="d-none d-lg-table-cell">Adresa</th>
                                    <th>Vende</th>
                                    <th class="text-end pe-4">Veprimet</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    foreach (var njesi in Model)
                                    {
                                        <tr>
                                            <td class="fw-bold ps-4">@njesi.Emri</td>
                                            <td class="d-none d-md-table-cell text-muted small">@njesi.Kodi</td>
                                            <td class="d-none d-lg-table-cell">@njesi.Adresa</td>
                                            <td>@njesi.VendeTeLira</td>
                                            <td class="text-end pe-4">
                                                <div class="d-flex justify-content-end gap-1">
                                                    @if (!njesi.QRScanner && ViewBag.customers)
                                                    {
                                                        <a asp-action="NjesiaQR" asp-route-id="@njesi.NjesiteId" class="btn btn-sm btn-activate-custom"><i class="bi bi-qr-code-scan"></i></a>
                                                    }
                                                    <a asp-action="Edit" asp-route-id="@njesi.NjesiteId" class="btn btn-sm btn-edit-custom"><i class="bi bi-pencil"></i></a>
                                                    <a asp-action="Delete" asp-route-id="@njesi.NjesiteId" class="btn btn-sm btn-delete-custom"><i class="bi bi-trash"></i></a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    @{
        var sherbimet = ViewBag.Sherbimet as List<Parking_web.Models.Sherbimi>;
    }
    <div class="card border-0 shadow-sm mb-4 mb-md-5 mx-2 mx-md-0">
        <div class="card-header bg-black text-white">
            <div class="header-content">
                <div class="clickable-title" data-bs-toggle="collapse" data-bs-target="#collSherbimet">
                    <span class="btn-minimize me-3"><i class="bi bi-chevron-down"></i></span>
                    <div>
                        <h5 class="fw-bold mb-0 text-white">Menaxhimi i Shërbimeve</h5>
                        <small class="opacity-75 d-none d-sm-block">Lista e shërbimeve dhe çmimeve</small>
                    </div>
                </div>
                <div class="action-button-area">
                    <a asp-controller="Sherbimi" asp-action="Create" class="btn btn-outline-light btn-sm px-4 rounded-pill fw-semibold">Shto Shërbim</a>
                </div>
            </div>
        </div>
        <div id="collSherbimet" class="collapse show">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 w-100">
                        <thead class="bg-light">
                            <tr><th class="ps-4">Emri</th><th>Çmimi</th><th class="text-end pe-4">Veprimet</th></tr>
                        </thead>
                        <tbody>
                            @if (sherbimet != null)
                            {
                                foreach (var s in sherbimet)
                                {
                                    <tr>
                                        <td class="fw-bold ps-4">@s.Emri</td>
                                        <td>
                                            @if (s.Cmimi != 0)
                                            {
                                                <span class="text-success fw-bold">@s.Cmimi.ToString("N2") €</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a asp-controller="Sherbimi" asp-action="Edit" asp-route-id="@s.SherbimiId" class="btn btn-sm btn-edit-custom"><i class="bi bi-pencil"></i></a>
                                                <a asp-controller="Sherbimi" asp-action="Delete" asp-route-id="@s.SherbimiId" class="btn btn-sm btn-delete-custom"><i class="bi bi-trash"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @{
        var cilsimet = (ViewBag.Cilsimet as List<Parking_web.Models.DTO.CilsimetReadDto>)?.OrderBy(n => n.NjesiOrg.Emri).ThenBy(c => c.Emri);
    }
    <div class="card border-0 shadow-sm mb-4 mb-md-5 mx-2 mx-md-0">
        <div class="card-header bg-black text-white">
            <div class="header-content">
                <div class="clickable-title" data-bs-toggle="collapse" data-bs-target="#collCilsimet">
                    <span class="btn-minimize me-3"><i class="bi bi-chevron-down"></i></span>
                    <div>
                        <h5 class="fw-bold mb-0 text-white">Cilësimet e Parkimit</h5>
                        <small class="opacity-75 d-none d-sm-block">Lidhja mes njësive dhe shërbimeve</small>
                    </div>
                </div>
                <div class="action-button-area">
                    <a asp-controller="Cilsimet" asp-action="Create" class="btn btn-outline-light btn-sm px-4 rounded-pill fw-semibold">Shto Cilësim</a>
                </div>
            </div>
        </div>
        <div id="collCilsimet" class="collapse show">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 w-100">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Emri</th>
                                <th>Njësia</th>
                                <th class="d-none d-md-table-cell">Sherbimi</th>
                                <th class="text-end pe-4">Veprimet</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (cilsimet != null)
                            {
                                foreach (var c in cilsimet)
                                {
                                    <tr class="clickable-row" data-href="@Url.Action("Detail", "Cilsimet", new { id = c.CilsimetiId })">
                                        <td class="fw-bold ps-4">@c.Emri</td>
                                        <td class="small">@c.NjesiOrg?.Emri</td>
                                        <td class="d-none d-md-table-cell text-muted">@c.Sherbimi.Emri</td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end align-items-center gap-2 prevent-row-click">
                                                @if (!c.Selected)
                                                {
                                                    <form asp-controller="Cilsimet" asp-action="Activate" asp-route-id="@c.CilsimetiId" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-activate-custom fw-semibold">Aktivizo</button>
                                                    </form>
                                                }
                                                <a asp-controller="Cilsimet" asp-action="Edit" asp-route-id="@c.CilsimetiId" class="btn btn-sm btn-edit-custom"><i class="bi bi-pencil"></i></a>
                                                <a asp-controller="Cilsimet" asp-action="Delete" asp-route-id="@c.CilsimetiId" class="btn btn-sm btn-delete-custom"><i class="bi bi-trash"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.action-button-area').forEach(area => {
            area.addEventListener('click', e => e.stopPropagation());
        });


        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".clickable-row").forEach(row => {
                row.addEventListener("click", function (e) {
                    if (e.target.closest(".prevent-row-click")) {
                        return;
                    }
                    const url = this.getAttribute("data-href");
                    if (url) {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
}