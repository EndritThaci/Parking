@using Parking_web.Models.DTO
@model OrgPage
@if (User.Identity == null || !User.Identity.IsAuthenticated)
{
    Context.Response.Redirect(Url.Action("Login", "Auth")!);
}
else if (User.IsInRole("Super Admin"))
{
    Context.Response.Redirect(Url.Action("Index", "Organizata")!);
}
else if (User.IsInRole("Manager") || User.IsInRole("Employee"))
{
    Context.Response.Redirect(Url.Action("Employee", "Home")!);
}
else if (User.IsInRole("Admin"))
{
    Context.Response.Redirect(Url.Action("SelectNjesi", "Home")!);
}
else
{
    var pendingList = (ViewBag.PendingTransactions as List<TransaksionRead>)?.OrderBy(t => t.KohaHyrjes).ToList();

    ViewData["Title"] = "Shtepia";

    var currentPage = Model.PageNumber;
    var pageSize = Model.PageSize;
    var totalPages = Model.TotalPages;

    <div class="container py-5">
        @if ((pendingList != null && pendingList.Any()))
        {
            var sum = pendingList.Count;
            <div class="mb-5">
                <div class="d-flex align-items-center mb-3 justify-content-center"
                     style="cursor: pointer;"
                     data-bs-toggle="collapse"
                     data-bs-target="#activeTransactions"
                     aria-expanded="true"
                     aria-controls="activeTransactions">

                    <div class="spinner-grow text-warning spinner-grow-sm me-2" role="status"></div>
                    @if (User.IsInRole("Customer"))
                    {
                        <h5 class="fw-bold text-dark mb-0">Transaksionet tuaja aktive (@sum)</h5>
                    }
                    else
                    {
                        <h5 class="fw-bold text-dark mb-0">Transaksionet aktive (@sum)</h5>
                    }
                    <i class="bi bi-chevron-down ms-2 transition-all collapse-arrow"></i>
                </div>

                <div class="collapse show" id="activeTransactions">
                    <div class="row g-3 justify-content-center pt-2">
                        <div class="row g-3 justify-content-center">
                            @foreach (var item in pendingList)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card border-0 shadow-sm h-100 overflow-hidden position-relative pending-card">
                                        <div class="pending-stripe"></div>
                                        <div class="card-body p-4">
                                            <a asp-controller="Home" asp-action="Pay" asp-route-id="@item.TransaksioniId" class="text-decoration-none">
                                                <div class="d-flex justify-content-between align-items-start @(item.Identifikues == null ? "mb-3" : "mb-1") ">
                                                    <div>
                                                        <h6 class="text-muted small text-uppercase fw-bold mb-1">Vendi i Parkimit</h6>
                                                        <h4 class="fw-black mb-0">@item.Njesia.Emri</h4>
                                                    </div>

                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 rounded-pill">
                                                        Në proces
                                                    </span>
                                                </div>

                                                <div class="d-flex align-items-center text-muted small @(item.Identifikues == null ? "mb-3" : "")">
                                                    <i class="bi bi-clock-history me-2"></i>
                                                    <span>Hyrja: <strong>@item.KohaHyrjes.ToString("HH:mm")</strong></span>
                                                    <span class="mx-2">|</span>
                                                    <span>Data: @item.KohaHyrjes.ToString("dd/MM")</span>
                                                </div>
                                                @if(item.Identifikues != null)
                                                {
                                                    <div class="d-flex align-items-center text-muted small mb-2">
                                                        <span><i class="bi bi-car-front-fill me-2"></i>Targat e automjetit: @item.Identifikues</span>
                                                    </div>
                                                }

                                                <a asp-controller="Home" asp-action="Pay" asp-route-id="@item.TransaksioniId"
                                                   class="btn btn-outline-warning w-100 rounded-pill fw-bold py-2 shadow-sm transition-all btn-pay">
                                                    Përzgjidh për Mbyllje
                                                </a>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <hr class="mt-5 mb-4 opacity-10">
            </div>
        }
        @{
            var currentSearch = Context.Request.Query["Search"].ToString();
            var onlyAvailable = Context.Request.Query["onlyAvailable"] == "true";
        }
        <div class="text-center mb-4 mt-5">
            <h3 class="fw-bold text-dark"> Organizatat </h3>
            <p> Zgjedh organizatën për të përzgjedhur njësinë </p>
        </div>
        <form method="get" asp-controller="Home" asp-action="Index" class="mb-5">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary p-2 p-md-3">
                        <div class="card-body p-0">
                            <div class="row g-2 align-items-center">
                                <div class="col-12 col-md">
                                    <div class="input-group input-group-lg border-0">
                                        <span class="input-group-text bg-white border-0 ps-3 rounded-start-3 text-primary">
                                            <i class="bi bi-search fs-5"></i>
                                        </span>
                                        <input type="text" 
                                               id="searchInput"
                                               name="Search" 
                                               value="@Context.Request.Query["Search"]" 
                                               class="form-control bg-white border-0 fs-6 pe-3 rounded-end-3 shadow-none" 
                                               placeholder="Kërko organizatë sipas emrit ose vendndodhjes..." 
                                               aria-label="Kërko organizatë" />

                                        <button type="button" 
                                                id="clearSearchBtn" 
                                                class="btn btn-link text-secondary text-decoration-none position-absolute end-0 top-50 translate-middle-y me-2 p-1 border-0 shadow-none @(string.IsNullOrEmpty(Context.Request.Query["Search"]) ? "d-none" : "")" 
                                                style="z-index: 5;"
                                                title="Pastro kërkimin">
                                            <i class="bi bi-x-circle-fill fs-6 opacity-75"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="d-none d-md-block col-auto">
                                    <div class="vr h-100 opacity-10"></div>
                                </div>

                                <div class="col-12 col-md-auto">
                                    <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-3 px-2 px-md-0">
                                        <div class="card bg-white border-0 rounded-4 p-md-2 px-1">
                                            <div class="form-check form-switch m-0 d-flex align-items-center gap-2 ps-0">
                                                <input class="form-check-input ms-0 mt-0 flex-shrink-0" 
                                                       type="checkbox" 
                                                       role="switch" 
                                                       id="onlyAvailable" 
                                                       name="onlyAvailable" 
                                                       value="true" 
                                                       style="width: 2.5em; height: 1.25em; cursor: pointer;"
                                                       @(onlyAvailable ? "checked" : "") />

                                                <label class="form-check-label small fw-semibold text-secondary user-select-none py-1" for="onlyAvailable" style="cursor: pointer;">
                                                    <i class="bi bi-p-circle-fill text-primary me-1"></i>
                                                    Vende të lira
                                                </label>
                                            </div>
                                        </div>

                                        <button type="submit" class="btn btn-primary btn-lg rounded-3 px-4 fs-6 fw-semibold shadow-sm d-flex align-items-center gap-2">
                                            <span>Kërko</span>
                                            <i class="bi bi-arrow-right short"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div class="row g-3 justify-content-center">
            @if (Model != null && Model.Data != null && Model.Data.Any())
            {
                foreach (var org in Model.Data)
                {
                    var njesite = org.Njesite ?? new List<NjesiReadDto>();
                    var totalFreeSpots = njesite.Sum(n => n.VendeTeLira);
                    var orgIsFull = njesite.Count == 0 || totalFreeSpots <= 0;

                    var cardClass = orgIsFull ? "unit-card unit-card-full" : "unit-card";
                    var stripeClass = orgIsFull ? "unit-stripe unit-stripe-full" : "unit-stripe";

                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100 overflow-hidden position-relative @cardClass" style="cursor:pointer;" 
                            onclick='openNjesiteModal(@org.BiznesId, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(org.EmriBiznesit)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(org.Njesite)))'>

                            <div class="@stripeClass"></div>
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="text-muted small text-uppercase fw-bold mb-1">
                                            Nr. i Biznesit: @org.NumriBiznesit
                                        </h6>
                                        <h4 class="fw-black mb-0 text-dark">
                                            @org.EmriBiznesit
                                        </h4>
                                    </div>
                                    <div class="org-icon @(orgIsFull ? "org-icon-full" : "")">
                                        <i class="bi bi-building"></i>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center text-muted small mb-3">
                                    <i class="bi bi-geo-alt me-2
                                       @(orgIsFull ? "text-danger" : "text-primary")">
                                    </i>
                                    <span class="text-truncate">
                                        @org.Adresa
                                    </span>
                                </div>
                                @if (orgIsFull)
                                {
                                    <div class="btn btn-outline-danger w-100 rounded-pill fw-bold py-2">
                                        Nuk ka vende të lira
                                        <i class="bi bi-x-circle ms-1"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="btn btn-outline-primary w-100 rounded-pill fw-bold py-2">
                                        Zgjedh Organizatën
                                        <i class="bi bi-chevron-right ms-1"></i>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="text-center py-5">
                        <i class="bi bi-building-x display-4 text-muted"></i>
                        <h5 class="fw-bold mt-3">
                            Nuk u gjet asnjë organizatë
                        </h5>
                    </div>
                </div>
            }
        </div>
        @if (Model != null && (Model.TotalPages > 1 || Model.TotalRecords > 8))
        {
            var currentPageSize = Model.PageSize;

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-5 gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small"> Shfaq: </span>

                    <select class="form-select form-select-sm" style="width:80px;" onchange="changePageSize(this.value)">
                        <option value="6" selected="@(currentPageSize == 6)"> 6 </option>
                        <option value="9" selected="@(currentPageSize == 9)"> 9 </option>
                        <option value="21" selected="@(currentPageSize == 21)"> 21 </option>
                        <option value="60" selected="@(currentPageSize == 60)"> 60 </option>
                    </select>
                    <span class="text-muted small"> për faqe </span>
                </div>
                <div class="text-muted small">
                    @{
                        var from = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                        var to = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords);
                    }
                    @from - @to nga @Model.TotalRecords organizata
                </div>
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination mb-0 justify-content-center">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-start-pill"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-route-Search="@currentSearch"
                               asp-route-onlyAvailable="@onlyAvailable"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-pageSize="@currentPageSize">

                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);
                        }
                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="Home"
                                   asp-action="Index"
                                   asp-route-Search="@currentSearch"
                                   asp-route-onlyAvailable="@onlyAvailable"
                                   asp-route-page="1"
                                   asp-route-pageSize="@currentPageSize">
                                    1
                                </a>
                            </li>

                            @if (startPage > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="Home"
                                   asp-action="Index"
                                   asp-route-Search="@currentSearch"
                                   asp-route-onlyAvailable="@onlyAvailable"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@currentPageSize">

                                    @i
                                </a>
                            </li>
                        }

                        @if (endPage < totalPages)
                        {
                            @if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="Home"
                                   asp-action="Index"
                                   asp-route-Search="@currentSearch"
                                   asp-route-onlyAvailable="@onlyAvailable"
                                   asp-route-page="@totalPages"
                                   asp-route-pageSize="@currentPageSize">

                                    @totalPages
                                </a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link rounded-end-pill"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-route-Search="@currentSearch"
                               asp-route-onlyAvailable="@onlyAvailable"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-pageSize="@currentPageSize">

                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
        <div class="modal fade" id="njesiteModal" tabindex="-1" aria-labelledby="njesiteModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg modal-rounded">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title fw-bold" id="njesiteModalLabel"> Zgjedh Njësinë </h5>
                            <small class="text-muted" id="njesiteModalSubtitle"> </small>
                        </div>

                        <button type="button" class="btn-close" data-bs-dismiss="modal"> </button>
                    </div>

                    <div class="modal-body p-4">
                        <div id="njesiteLoading" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"> </div>
                            <div class="mt-2 text-muted"> Duke ngarkuar njësitë... </div>
                        </div>

                        <div id="njesiteError" class="alert alert-danger d-none"> </div>
                        <div id="njesiteList" class="d-flex flex-column gap-2"> </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="cameraModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-qr-code-scan me-2"></i>
                            Skano QR Kodin
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                onclick="stopCamera()">
                        </button>
                    </div>

                    <div class="modal-body">
                        <div id="qr-reader" style="width: 100%;"></div>

                        <div id="qr-result"
                             class="alert alert-success mt-3 d-none">
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

<style>
    .unit-card {
        border-radius: 20px;
        transition: all 0.3s ease;
        background: #ffffff;
        cursor: pointer;
    }

        .unit-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(13, 110, 253, 0.1) !important;
            border: 1px solid #0d6efd !important;
        }

    .unit-stripe {
        position: absolute;
        top: 0;
        left: 0;
        width: 6px;
        height: 100%;
        background: #0d6efd;
    }

    .btn-unit-action:hover {
        background-color: #0d6efd !important;
        color: white !important;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.2);
    }

    .tracking-wider {
        letter-spacing: 1px;
    }

    .pending-card {
        border-radius: 20px;
        transition: all 0.3s ease;
        background: #fff;
        cursor: pointer;
    }

        .pending-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
            border: 1px solid #ffc107 !important;
        }

    .pending-stripe {
        position: absolute;
        top: 0;
        left: 0;
        width: 6px;
        height: 100%;
        background: #ffc107;
    }

    .fw-black {
        font-weight: 900;
        color: #2b2b2b;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .btn-pay:hover {
        background-color: #ffc107 !important;
        border-color: #ffc107 !important;
        color: #ffffff !important;
    }
    .btn-pay1:hover {
        background-color: #ff5157 !important;
        border-color: #ff5157 !important;
        color: #fff !important;
    }

    .spinner-grow {
        animation-duration: 1.5s;
    }

    [data-bs-toggle="collapse"]:hover h5 {
        color: #ffc107 !important;
    }

    .org-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e7f1ff;
        color: #0d6efd;
        font-size: 20px;
    }

    .njesia-option {
        display: block;
        padding: 14px;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        transition: all 0.2s ease;
        background: #fff;
    }

        .njesia-option:hover {
            border-color: #0d6efd;
            background: #f8fbff;
            transform: translateX(3px);
        }

    .njesia-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e7f1ff;
        color: #0d6efd;
        font-size: 20px;
    }

    .unit-card-full:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(220, 53, 69, 0.15) !important;
        border: 1px solid #dc3545 !important;
    }

    .unit-stripe-full {
        background: #dc3545 !important;
    }

    .org-icon-full {
        background: #f8d7da !important;
        color: #dc3545 !important;
    }

    .modal-rounded {
        border-radius: 20px;
        overflow: hidden;
    }

    .pagination .page-link {
        border: none;
        margin: 0 2px;
        border-radius: 10px;
        min-width: 38px;
        text-align: center;
    }

        .pagination .page-item.active .page-link {
            background: #0d6efd;
            color: #fff;
        }

    .njesia-full {
        display: block;
        padding: 14px;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        transition: all 0.2s ease;
        background: #fff;
        cursor: not-allowed;
    }

        .njesia-full:hover {
            border-color: #dc3545;
            background: #fff5f5;
            transform: translateX(3px);
        }

        .njesia-full .njesia-icon {
            background: #f8d7da;
            color: #dc3545;
        }

        .njesia-full .text-primary {
            color: #dc3545 !important;
        }
</style>

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const onlyAvailable = document.getElementById('onlyAvailable');
        const searchInput = document.getElementById("searchInput");
        const clearBtn = document.getElementById("clearSearchBtn");

        if (onlyAvailable)
        {
            onlyAvailable.addEventListener('change', function () {
                const url = new URL(window.location.href);

                if (this.checked) {
                    url.searchParams.set('onlyAvailable', 'true');
                } else {
                    url.searchParams.delete('onlyAvailable');
                }

                url.searchParams.set('page', '1');
                window.location.href = url.toString();
            });
        }
        if(searchInput)
        {
            searchInput.addEventListener("input", function () {
                if (this.value.trim().length > 0) {
                    clearBtn.classList.remove("d-none");
                } else {
                    clearBtn.classList.add("d-none");
                }
            });
            if(clearBtn)
            {
                clearBtn.addEventListener("click", function () {
                    searchInput.value = "";
                    clearBtn.classList.add("d-none");

                    const url = new URL(window.location.href);
                    url.searchParams.delete('Search');
                    url.searchParams.set('page', '1');
                    window.location.href = url.toString();
                });
            }
        }
    });

    function changePageSize(pageSize) {
        const url = new URL(window.location.href);

        url.searchParams.set('page', '1');
        url.searchParams.set('pageSize', pageSize);
        window.location.href = url.toString();
    }


    async function openNjesiteModal(orgId, orgName, njesite) {
        const modalElement = document.getElementById('njesiteModal');

        if (!modalElement) {
            console.error('njesiteModal was not found.');
            return;
        }

        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

        const title = document.getElementById('njesiteModalLabel');
        const subtitle = document.getElementById('njesiteModalSubtitle');

        const loading = document.getElementById('njesiteLoading');
        const error = document.getElementById('njesiteError');
        const list = document.getElementById('njesiteList');

        title.innerText = 'Zgjedh Njësinë';
        subtitle.innerText = 'Org: ' + orgName;

        loading.classList.add('d-none');
        error.classList.add('d-none');
        list.innerHTML = '';

        try {
            njesite = njesite || [];

            if (njesite.length === 0) {
                list.innerHTML = `
                    <div class="text-center py-4">
                        <i class="bi bi-building-x display-6 text-muted"></i>
                        <h6 class="fw-bold mt-3">
                            Nuk ka njësi
                        </h6>
                        <p class="text-muted small mb-0">
                            Kjo organizatë nuk ka njësi të disponueshme.
                        </p>
                    </div>
                `;
                modal.show();
                return;
            }

            if (njesite.length === 1) {
                const njesia = njesite[0];

                if (njesia.VendeTeLira <= 0) {
                    list.innerHTML = `
                        <div class="text-center py-4">
                            <i class="bi bi-p-circle display-6 text-danger"></i>
                            <h6 class="fw-bold mt-3">
                                Nuk ka vende të lira
                            </h6>
                            <p class="text-muted small mb-0">
                                Njësia
                                <strong>${escapeHtml(njesia.Emri)}</strong>
                                nuk ka vende të lira.
                            </p>
                        </div>
                    `;
                    modal.show();
                    return;
                }
                window.location.href = `/Home/Create?njesiaId=${encodeURIComponent(njesia.NjesiteId)}`;
                return;
            }

            njesite.forEach(njesia => {
                const item = document.createElement('a');
                const isFull = njesia.VendeTeLira <= 0;
                item.className = 'njesia-option text-decoration-none';

                if (isFull) {
                    item.classList.add('njesia-full');
                    item.href = 'javascript:void(0)';
                    item.setAttribute('aria-disabled', 'true');
                }
                else {
                    item.href = `/Home/Create?njesiaId=${encodeURIComponent(njesia.NjesiteId)}`;
                }

                item.innerHTML = `
                    <div class="d-flex align-items-center">
                        <div class="njesia-icon me-3">
                            <i class="bi bi-p-square"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark">
                                ${escapeHtml(njesia.Emri)}
                            </div>
                            <div class="small text-muted">
                                Kodi: ${escapeHtml(njesia.Kodi)}
                            </div>
                            <div class="small text-muted">
                                <i class="bi bi-geo-alt me-1"></i>
                                ${escapeHtml(njesia.Adresa)}
                            </div>
                        </div>
                        <div class="text-end me-3">
                            <div class="small text-muted">
                                Vende të lira
                            </div>
                            <strong class="${isFull ? 'text-danger' : 'text-primary'}">
                                ${njesia.VendeTeLira}
                            </strong>
                        </div>
                        ${
                            isFull ? '<i class="bi bi-x-circle text-danger"></i>' : '<i class="bi bi-chevron-right text-primary"></i>'
                        }
                    </div>
                `;
                list.appendChild(item);
            });
            modal.show();
        }
        catch (err) {
            loading.classList.add('d-none');
            error.innerText = err.message || 'Gabim gjatë shfaqjes së njësive.';
            error.classList.remove('d-none');
            modal.show();
        }
    }


    function escapeHtml(value) {
        if (value == null)
            return '';

        return String(value)
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }
</script>