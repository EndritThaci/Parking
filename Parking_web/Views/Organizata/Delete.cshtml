@model Parking_web.Models.Organizata
@{
    ViewData["Title"] = "Fshirja e Organizatës";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-bottom-5">
                <div class="card-header bg-danger text-white py-3 text-center rounded-top-5">
                    <h5 class="mb-0 fw-bold">Konfirmo Fshirjen e Organizatës</h5>
                </div>

                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
                        <h4 class="mt-2 text-dark">A jeni i sigurt?</h4>
                        <p class="text-muted">
                            Ky veprim do të fshijë përgjithmonë organizatën <strong>@Model.EmriBiznesit</strong> dhe të gjitha të dhënat e ndërlidhura në sistem.
                        </p>
                    </div>

                    <div class="bg-light p-3 rounded mb-4 text-start">
                        <div class="small text-muted text-uppercase fw-bold mb-2">Detajet e Organizatës:</div>

                        <div class="d-flex justify-content-between border-bottom py-2">
                            <span class="text-secondary">NUI / Biznes ID:</span>
                            <span class="fw-bold">@Model.NumriUnikIdentifikues</span>
                        </div>

                        <div class="d-flex justify-content-between border-bottom py-2">
                            <span class="text-secondary">Numri Fiskal:</span>
                            <span class="fw-bold text-dark">@Model.NumriFiskal</span>
                        </div>

                        <div class="d-flex justify-content-between border-bottom py-2">
                            <span class="text-secondary">Email:</span>
                            <span class="fw-bold text-dark">@Model.Email</span>
                        </div>

                        <div class="d-flex justify-content-between py-2">
                            <span class="text-secondary">Adresa:</span>
                            <span class="fw-bold text-dark">@Model.Adresa, @Model.Komuna</span>
                        </div>
                    </div>

                    <form method="post" asp-action="Delete">
                        <input type="hidden" asp-for="BiznesId" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold shadow-sm">
                                Po, Fshije Organizatën
                            </button>
                            <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none">
                                Anulo, kthehu mbrapa
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            <p class="text-center text-muted mt-3 small">
                <i class="bi bi-info-circle"></i> Ky veprim nuk mund të kthehet mbrapa pasi të konfirmohet.
            </p>
        </div>
    </div>
</div>