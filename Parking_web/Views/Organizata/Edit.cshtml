@model Parking_web.Models.DTO.OrgUpdateDTO
@{
    ViewData["Title"] = "Përditësimi i Organizatës";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-white py-3">
                    <h5 class="mb-0 fw-bold">Përditëso Detajet e Organizatës</h5>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <input type="hidden" asp-for="BiznesId" />

                        <!-- Emri Biznesit -->
                        <div class="mb-3">
                            <label asp-for="EmriBiznesit" class="form-label fw-semibold">Emri i Biznesit</label>
                            <input asp-for="EmriBiznesit" class="form-control" placeholder="Shkruani emrin e biznesit" />
                            <span asp-validation-for="EmriBiznesit" class="text-danger small"></span>
                        </div>

                        <!-- Numri Unik & Numri Biznesit -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NumriUnikIdentifikues" class="form-label fw-semibold">NUI (Numri Unik)</label>
                                <input asp-for="NumriUnikIdentifikues" class="form-control" />
                                <span asp-validation-for="NumriUnikIdentifikues" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="NumriBiznesit" class="form-label fw-semibold">Numri i Biznesit</label>
                                <input asp-for="NumriBiznesit" class="form-control" />
                                <span asp-validation-for="NumriBiznesit" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NumriFiskal" class="form-label fw-semibold">Numri Fiskal</label>
                                <input asp-for="NumriFiskal" class="form-control" />
                                <span asp-validation-for="NumriFiskal" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="NumriPunetoreve" class="form-label fw-semibold">Numri i Punëtorëve</label>
                                <input asp-for="NumriPunetoreve" type="number" class="form-control" />
                                <span asp-validation-for="NumriPunetoreve" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Adresa" class="form-label fw-semibold">Adresa</label>
                            <input asp-for="Adresa" class="form-control" />
                            <span asp-validation-for="Adresa" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Komuna" class="form-label fw-semibold">Komuna</label>
                            <input asp-for="Komuna" class="form-control" />
                            <span asp-validation-for="Komuna" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefoni" class="form-label fw-semibold">Telefoni</label>
                                <input asp-for="Telefoni" class="form-control" />
                                <span asp-validation-for="Telefoni" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Email</label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end border-top pt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Anulo</a>
                            <button type="submit" class="btn btn-warning text-white px-4 rounded-pill fw-bold shadow-sm">
                                Ruaj Ndryshimet
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
