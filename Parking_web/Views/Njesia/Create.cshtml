@model Parking_web.Models.DTO.NjesiOrgDto
@{
    ViewData["Title"] = "Krijimi i Njësisë";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold">Shto Njësi të Re</h5>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Emri" class="form-label fw-semibold">Emri i Njësisë</label>
                            <input asp-for="Emri" class="form-control" placeholder="Psh. Emri i pikës ose degës" />
                            <span asp-validation-for="Emri" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Adresa" class="form-label fw-semibold">Adresa</label>
                            <input asp-for="Adresa" class="form-control" placeholder="Lokacioni" />
                            <span asp-validation-for="Adresa" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Kodi" class="form-label fw-semibold">Kodi i Njësisë</label>
                                <input asp-for="Kodi" class="form-control" placeholder="Kodi unik" />
                                <span asp-validation-for="Kodi" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="VendeTeLira" class="form-label fw-semibold">Vende të Lira</label>
                                <input asp-for="VendeTeLira" type="number" class="form-control" min="0" placeholder="0" />
                                <span asp-validation-for="VendeTeLira" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="QRScanner" class="form-check-input" type="checkbox" role="switch" id="qrScanner" />

                                <label asp-for="QRScanner" class="form-check-label fw-semibold" for="qrScanner">
                                    Skano QR kodin e klientit
                                </label>
                            </div>

                            <small class="text-muted">
                                Aktivizoni këtë opsion nëse kjo organizatë skanon kodin e klientëve. Përndryshe klientët do të skenojnë kodin e njësisë.
                            </small>

                            <span asp-validation-for="QRScanner" class="text-danger small d-block"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end border-top pt-3">
                            <a asp-action="Index2" class="btn btn-outline-secondary px-4 rounded-pill">Anulo</a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm">
                                Krijo Njësinë
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
