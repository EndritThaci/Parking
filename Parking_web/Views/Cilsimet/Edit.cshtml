@model Parking_web.Models.DTO.CilsimetWithDetailsUpdateDTO
@{
    ViewData["Title"] = "Përditësimi i Cilësimit";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-white py-3">
                    <h5 class="mb-0 fw-bold">Përditëso Cilësimin</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CilsimetiId" />

                        <div class="mb-3">
                            <label asp-for="Emri" class="form-label fw-semibold">Emri i Cilësimit</label>
                            <input asp-for="Emri" class="form-control" />
                            <span asp-validation-for="Emri" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NjesiteId" class="form-label fw-semibold">Përzgjidh Njësinë</label>

                                @if (ViewBag.IsFixed == true)
                                {
                                    <select asp-for="NjesiteId" class="form-select bg-light text-muted"
                                            asp-items="ViewBag.NjesiteList" disabled>
                                    </select>
                                    <input type="hidden" asp-for="NjesiteId" />
                                    <small class="text-info"><i class="bi bi-info-circle me-1"></i> Njësia është paracaktuar.</small>
                                }
                                else
                                {
                                    <select asp-for="NjesiteId" class="form-select"
                                            asp-items="ViewBag.NjesiteList">
                                        <option value="" disabled>-- Zgjedh Njësinë --</option>
                                    </select>
                                }
                                <span asp-validation-for="NjesiteId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SherbimiId" class="form-label fw-semibold">Përzgjidh Shërbimin</label>
                                <select asp-for="SherbimiId" class="form-select"
                                        asp-items="ViewBag.SherbimetList">
                                    <option value="" disabled>-- Zgjedh Shërbimin --</option>
                                </select>
                                <span asp-validation-for="SherbimiId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="border rounded p-3 bg-light mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h6 class="mb-0 fw-bold text-secondary">Detajet e Tarifave për Orë</h6>
                                    <small class="text-muted">Modifikoni tarifat ose shtoni të reja</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3" id="btnAddDetail">
                                    <i class="bi bi-plus-lg me-1"></i> Shto Tarifë
                                </button>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered bg-white align-middle" id="detailsTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Prej</th>
                                            <th>Deri 
                                                <i class="bi bi-info-circle text-primary ms-1" 
                                                    data-bs-toggle="tooltip" 
                                                    data-bs-placement="top" 
                                                    title="Nëse lihet bosh, nënkupton pa kufi kohor (pakufi)."></i>
                                            </th>
                                            <th>Çmimi (€)</th>
                                            <th class="text-center" style="width: 70px;">Veprim</th>
                                        </tr>
                                    </thead>
                                    <tbody id="detailsContainer">
                                        @if (Model?.Detajet != null && Model.Detajet.Any())
                                        {
                                            for (int i = 0; i < Model.Detajet.Count; i++)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="hidden" name="Detajet[@i].DetajetId" value="@Model.Detajet[i].DetajetId" />
                                                        <input type="hidden" name="Detajet[@i].CilsimetiId" value="@Model.CilsimetiId" />

                                                        <input name="Detajet[@i].FromHour" value="@Model.Detajet[i].FromHour" class="form-control" type="number" min="0" />
                                                    </td>
                                                    <td>
                                                        <input name="Detajet[@i].ToHour" value="@Model.Detajet[i].ToHour" class="form-control" type="number" min="0" />
                                                    </td>
                                                    <td>
                                                        <input name="Detajet[@i].Cmimi" value="@Model.Detajet[i].Cmimi" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" required />
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-outline-danger btn-sm remove-row" title="Fshi">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end border-top pt-3 mt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Kthehu</a>
                            <button type="submit" class="btn btn-warning text-white px-4 rounded-pill fw-bold shadow-sm">Ruaj Ndryshimet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const container = document.getElementById("detailsContainer");
            const btnAdd = document.getElementById("btnAddDetail");
            const cilsimetiId = document.getElementById("CilsimetiId").value;

            function reindexRows() {
                const rows = container.querySelectorAll("tr");
                rows.forEach((row, index) => {
                    const inputs = row.querySelectorAll("input");
                    inputs.forEach(input => {
                        const name = input.getAttribute("name");
                        if (name) {
                            input.setAttribute("name", name.replace(/\[\d+\]/, `[${index}]`));
                        }
                    });
                });
            }

            btnAdd.addEventListener("click", function () {
                const index = container.querySelectorAll("tr").length;
                const newRow = document.createElement("tr");

                newRow.innerHTML = `
                    <td>
                        <input type="hidden" name="Detajet[${index}].DetajetId" value="0" />
                        <input type="hidden" name="Detajet[${index}].CilsimetiId" value="${cilsimetiId}" />
                        <input name="Detajet[${index}].FromHour" class="form-control" type="number" min="0" />
                    </td>
                    <td>
                        <input name="Detajet[${index}].ToHour" class="form-control" type="number" min="0" />
                    </td>
                    <td>
                        <input name="Detajet[${index}].Cmimi" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" required />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm remove-row" title="Fshi">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                `;

                container.appendChild(newRow);
            });

            container.addEventListener("click", function (e) {
                if (e.target.closest(".remove-row")) {
                    e.target.closest("tr").remove();
                    reindexRows();
                }
            });
        });
    </script>
}