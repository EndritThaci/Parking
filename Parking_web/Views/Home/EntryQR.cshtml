@model int

@{
    ViewData["Title"] = "Skanimi i QR Kodit per Hyrje";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-lg border-0 rounded-4 p-4">

                <div>
                    <h3 class="fw-bold mb-3 text-primary">QR Kodi për Hyrje</h3>
                    <p class="text-muted">Skanoni kodin e mëposhtëm për të procesuar veprimin automatikisht.</p>

                    <div id="qr-to-print" class="qr-container my-4 p-2 p-sm-3 bg-light rounded-3 d-inline-block">
                        <img src="@Url.Action("QRGenerate", "Home", new { njesiaId = Model, userId = ViewBag.UserId, identifikues = ViewBag.identifikues})"
                             alt="QR Code"
                             class="img-fluid qr-image" />
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button onclick="window.print()" class="btn btn-primary btn-lg rounded-pill fw-bold shadow">
                        <i class="bi bi-printer me-2"></i> Printo Kodin
                    </button>
                    <a asp-action="Index" class="btn btn-lg rounded-pill">Kthehu</a>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    @@page {
        margin: 0;
    }

    .qr-container {
        max-width: 100%;
        width: 340px;
    }

    .qr-image {
        display: block;
        width: 100%;
        max-width: 300px;
        height: auto;
        margin: 0 auto;
        border: 10px solid white;
        box-sizing: border-box;
    }

    @@media (max-width: 576px) {
        .qr-container {
            width: 100%;
            max-width: 320px;
            padding: 8px !important;
        }

        .qr-image {
            max-width: 100%;
            border-width: 6px;
        }
    }

    @@page {
        size: A4 portrait;
        margin: 0;
    }

    @@media print {
        html, body {
            width: 100vw !important;
            height: 100vh !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            background: #ffffff !important;
        }
            
        body * {
            visibility: hidden;
        }

        #qr-to-print, #qr-to-print * {
            visibility: visible !important;
        }

        #qr-to-print {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 85vw !important;
            max-width: 85vh !important; 
            height: auto;
            margin: 0 !important;
            padding: 0 !important;
            box-shadow: none !important;
            border-radius: 0 !important;
            display: flex !important;
            align-items: center;
            justify-content: center;
        }

        .qr-image {
            width: 100% !important;
            max-width: 100% !important;
            height: auto !important;
            border: 20px solid white !important; 
        }

        .btn, .btn-link, .no-print, h3, p {
            display: none !important;
        }
    }
</style>